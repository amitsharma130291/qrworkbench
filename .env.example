# Gmail account the contact form sends from, and a Google App Password for
# it (not the regular account password) -- generate one at
# https://myaccount.google.com/apppasswords with 2-Step Verification on.
# Set these as real environment variables in the Vercel project dashboard
# for production; for local testing, copy this file to .env (gitignored)
# and fill in real values.
#
# Dual-purpose: also sends the purchase-confirmation / license-recovery
# emails for the Dodo integration below (src/lib/server/license.js), so this
# is required for that to work, not just the contact form.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Dodo Payments -- powers checkout and license-key entitlement for the
# /bulk workspace. Create two one-time-payment products in the Dodo
# dashboard (Batch Pass -- $7, Pro -- $39 lifetime); License Keys does NOT
# need to be enabled on them -- license keys here are generated by our own
# code (src/lib/server/license.js), not Dodo's, so there's no per-product
# activation-limit configuration needed. Get the API key from Dodo's
# dashboard under Developer > API Keys.
#
# Every one of these is server-only (no PUBLIC_ prefix needed anywhere) --
# the browser only ever talks to our own /api/checkout/* and /api/license/*
# routes, never Dodo's API directly.
DODO_PAYMENTS_API_KEY=your-dodo-api-key
DODO_ENVIRONMENT=test_mode

# Add a webhook endpoint in the Dodo dashboard pointing at
# https://www.qrworkbench.com/api/webhooks/dodo, subscribed to
# payment.succeeded, then paste its signing secret here. This is a
# reliability backstop, not the primary unlock path: its only job is
# emailing the license key if a customer closes the tab before the checkout
# redirect completes (see src/pages/api/webhooks/dodo.js).
DODO_PAYMENTS_WEBHOOK_KEY=your-dodo-webhook-signing-secret

# Product IDs (pdt_...) from the Dodo dashboard for each one-time-payment tier.
DODO_PRODUCT_ID_BATCH=pdt_your-batch-pass-product-id
DODO_PRODUCT_ID_PRO=pdt_your-pro-product-id
