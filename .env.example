# Gmail account the contact form sends from, and a Google App Password for
# it (not the regular account password) -- generate one at
# https://myaccount.google.com/apppasswords with 2-Step Verification on.
# Set these as real environment variables in the Vercel project dashboard
# for production; for local testing, copy this file to .env (gitignored)
# and fill in real values.
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# Dodo Payments -- powers checkout and license-key entitlement for the
# /bulk workspace. Create two one-time-payment products in the Dodo
# dashboard (Batch Pass -- $7, Pro -- $39 lifetime) with license keys
# enabled, then fill these in. Get the API key from Dodo's dashboard under
# Developer > API Keys.
#
# DODO_PAYMENTS_API_KEY is a secret -- used only by the server-side
# /api/checkout route to create checkout sessions. Never expose it to the
# browser (that's why it has no PUBLIC_ prefix).
DODO_PAYMENTS_API_KEY=your-dodo-api-key

# Astro exposes PUBLIC_-prefixed vars to both server and browser code (the
# non-prefixed vars above are server-only), so one PUBLIC_ var here covers
# both /api/checkout.js (server) and src/lib/license.js (browser), which
# both need to pick test.dodopayments.com vs live.dodopayments.com.
PUBLIC_DODO_ENVIRONMENT=test_mode

# No DODO_PAYMENTS_RETURN_URL here -- /api/checkout.js computes it from the
# incoming request's own origin, so it's automatically correct on localhost
# and in production without needing to be kept in sync.
#
# No webhook secret either -- this integration doesn't use a webhook. Dodo's
# /licenses/activate and /licenses/validate are public, keyless endpoints
# called straight from the browser after checkout; that's the entire
# entitlement mechanism (see src/lib/license.js).

# Product IDs (pdt_...) from the Dodo dashboard for each one-time-payment tier.
PUBLIC_DODO_PRODUCT_SINGLE_ID=pdt_your-batch-pass-product-id
PUBLIC_DODO_PRODUCT_PRO_ID=pdt_your-pro-product-id
