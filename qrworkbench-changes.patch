 const GA_MEASUREMENT_ID = "G-2SFMNJ70K7";
+
+// GA4 is switched off for now so dev/debugging traffic doesn't get counted
+// as real pageviews. Flip this back to `true` before shipping to production.
+const GA_ENABLED = false;
 ---
