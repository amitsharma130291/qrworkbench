diff --git a/src/components/GeneratorShell.astro b/src/components/GeneratorShell.astro
index 25781eb..f4c1fd0 100644
--- a/src/components/GeneratorShell.astro
+++ b/src/components/GeneratorShell.astro
@@ -132,4 +132,16 @@ const { filenamePrefix = "qr-code" } = Astro.props;
     .tool-grid { grid-template-columns: 1fr; }
     .tool-inputs :global(.field-row) { grid-template-columns: 1fr; }
   }
+
+  /* Smallest phones (iPhone SE and similar, ~320-380px wide): the fixed
+     1.8rem shell padding plus a permanent 2-column control grid leaves each
+     select only ~90px, cramped enough to matter. Trim padding and let the
+     lower-value controls (foreground/background/size/error-correction) go
+     full width instead of fighting for half a row. */
+  @media (max-width: 400px) {
+    .tool-shell { padding: 1.1rem; }
+    .ctrl-grid { grid-template-columns: 1fr; }
+    .ctrl-check { grid-column: span 1; }
+    .dl-row { flex-direction: column; }
+  }
 </style>
diff --git a/src/components/LabelsWorkspace.astro b/src/components/LabelsWorkspace.astro
index e0b1d4a..467a558 100644
--- a/src/components/LabelsWorkspace.astro
+++ b/src/components/LabelsWorkspace.astro
@@ -540,10 +540,21 @@
   .field-list select:disabled { color: var(--ink-faint); background: var(--bg); }
   .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem; }
 
-  .sheet-preview { max-height: 360px; overflow-y: auto; }
+  /* overflow-x here is the safety net for the min-width:0 fix below -- if a
+     high column count + long captions still add up to more than the panel
+     can fit, this panel scrolls internally instead of silently blowing out
+     the whole page's width (app-body's overflow-x:hidden would otherwise
+     just clip it with no way to reach the rest). */
+  .sheet-preview { max-height: 360px; overflow-y: auto; overflow-x: auto; }
   .empty-note { font-size: 0.8rem; color: var(--ink-faint); margin: 0; }
   .sheet-grid { display: grid; gap: 0.5rem; }
-  .sheet-cell { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; border: 1px solid var(--line); padding: 0.4rem; }
+  /* min-width:0 overrides the grid item's default automatic minimum size,
+     which is otherwise based on its content's min-content width. Without
+     it, .sheet-cell span's white-space:nowrap gives every cell a large
+     intrinsic minimum -- at higher column counts (this tool allows up to
+     10) that forces the grid wider than its container on mobile instead of
+     actually respecting the `1fr` track sizing. */
+  .sheet-cell { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; border: 1px solid var(--line); padding: 0.4rem; min-width: 0; }
   .sheet-cell canvas { width: 100%; height: auto; max-width: 70px; }
   .sheet-cell span { font-size: 0.6rem; color: var(--ink-dim); text-align: center; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 100%; }
 
@@ -578,4 +589,11 @@
     .panel { border-right: none; }
