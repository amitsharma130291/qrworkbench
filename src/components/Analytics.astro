---
const GA_MEASUREMENT_ID = "G-2SFMNJ70K7";

// GA4 is live — dev/debug traffic should be filtered at the GA4 property
// level (e.g. an internal-traffic filter) rather than by disabling the tag,
// now that this is shipping to production.
const GA_ENABLED = true;
---
{GA_ENABLED && (
  <Fragment>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
    <script define:vars={{ GA_MEASUREMENT_ID }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag() { dataLayer.push(arguments); };
      gtag("js", new Date());
      gtag("config", GA_MEASUREMENT_ID);
    </script>
  </Fragment>
)}
