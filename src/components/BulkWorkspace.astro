---
---
<div class="ws-head">
  <div>
    <h1>Bulk QR Generator</h1>
    <p>Generate a folder of correctly named QR codes from your spreadsheet — right here, in this tab.</p>
  </div>
  <div class="privacy-box">
    <svg width="18" height="18" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 1.5 13.5 3.6v3.9c0 3.4-2.3 6.3-5.5 7-3.2-.7-5.5-3.6-5.5-7V3.6L8 1.5Z" stroke="var(--ink)" stroke-width="1.3" stroke-linejoin="round"/></svg>
    <div><strong>100% Private</strong><span>Everything stays in your browser</span></div>
  </div>
</div>

<div id="settings-note" class="settings-note" hidden>
  <strong>Your QR design is ready.</strong> The size, error correction and margin from your free QR code are already set below — upload a spreadsheet to apply them to every row.
</div>

<div id="tier-banner" class="tier-banner">
  <div class="tb-status">
    <strong id="tb-title">Free plan</strong>
    <span id="tb-desc">Up to 20 QR codes per batch, then upgrade for unlimited.</span>
  </div>
  <div class="tb-actions" id="tb-actions">
    <button class="btn btn-fill" id="tb-buy-batch" type="button">Batch Pass — $7</button>
    <button class="btn btn-accent" id="tb-buy-pro" type="button">Pro — $39</button>
    <button class="link-btn" id="tb-toggle-key" type="button">Have a license key?</button>
    <button class="link-btn" id="tb-change-key" type="button" hidden>Use a different license key</button>
  </div>
  <form id="tb-key-form" class="tb-key-form" hidden>
    <input id="tb-key-input" type="text" placeholder="License key" aria-label="License key" autocomplete="off" />
    <button class="btn" type="submit">Unlock</button>
    <button class="link-btn" id="tb-toggle-recover" type="button">Forgot your key?</button>
    <p id="tb-key-error" class="tb-key-error" hidden></p>
  </form>
  <form id="tb-recover-form" class="tb-key-form" hidden>
    <input id="tb-recover-email" type="email" placeholder="Email used at checkout" aria-label="Email used at checkout" autocomplete="email" />
    <button class="btn" type="submit">Send my key</button>
    <p id="tb-recover-status" class="tb-key-status" hidden></p>
  </form>
</div>

<div id="error-banner" class="error-banner" hidden></div>

<div class="panels">
  <section id="upload" class="panel">
    <h2><span class="pn">01</span>Upload file</h2>
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Upload a CSV file">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="var(--ink-faint)" stroke-width="1.4"><path d="M12 3v12M7 10l5-5 5 5" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 16v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <p><strong>Drop a CSV file here</strong><br />or click to browse</p>
      <span class="hint">Supports CSV · header row required</span>
    </div>
    <button id="sample-csv" class="sample-link" type="button">↓ Download a 75-row sample CSV to try it</button>
    <input id="file-input" type="file" accept=".csv,text/csv" hidden />
    <div id="file-info" class="file-info" hidden>
      <div class="file-info-icon">✓</div>
      <div class="file-info-text">
        <strong id="file-name"></strong>
        <span id="file-rows"></span>
      </div>
      <button id="replace-file" class="btn" type="button">Replace file</button>
    </div>
  </section>

  <section id="map" class="panel">
    <h2><span class="pn">02</span>Map columns</h2>
    <div class="field-list" id="map-fields">
      <div class="map-group" data-type="url">
        <label>QR data <em>(required)</em><select id="map-qrdata" disabled></select></label>
      </div>
      <div class="map-group" data-type="wifi" hidden>
        <label>Network name / SSID <em>(required)</em><select id="map-wifi-ssid" disabled></select></label>
        <label>Password <em>(optional)</em><select id="map-wifi-password" disabled></select></label>
      </div>
      <div class="map-group" data-type="vcard" hidden>
        <label>First name <em>(required)</em><select id="map-vcard-first" disabled></select></label>
        <label>Last name <em>(optional)</em><select id="map-vcard-last" disabled></select></label>
        <label>Company <em>(optional)</em><select id="map-vcard-org" disabled></select></label>
        <label>Job title <em>(optional)</em><select id="map-vcard-title" disabled></select></label>
        <label>Phone <em>(optional)</em><select id="map-vcard-phone" disabled></select></label>
        <label>Email <em>(optional)</em><select id="map-vcard-email" disabled></select></label>
        <label>Website <em>(optional)</em><select id="map-vcard-url" disabled></select></label>
        <label>Address <em>(optional)</em><select id="map-vcard-address" disabled></select></label>
      </div>
      <label>Filename<select id="map-filename" disabled></select></label>
      <label>Caption <em>(optional)</em><select id="map-caption" disabled></select></label>
      <label>Price <em>(optional)</em><select id="map-price" disabled></select></label>
      <label>Category <em>(optional)</em><select id="map-category" disabled></select></label>
    </div>
  </section>

  <section id="configure" class="panel">
    <h2><span class="pn">03</span>Configure</h2>
    <div class="field-list">
      <label>QR code type<select id="cfg-type">
        <option value="url" selected>URL / plain text</option>
        <option value="wifi">WiFi</option>
        <option value="vcard">vCard</option>
      </select></label>
      <div class="field-row" id="cfg-wifi-extra" hidden>
        <label>Security type<select id="cfg-wifi-security">
          <option value="WPA" selected>WPA / WPA2</option>
          <option value="WEP">WEP</option>
          <option value="nopass">Open (no password)</option>
        </select></label>
        <label class="toggle-row"><span>Hidden network</span><input id="cfg-wifi-hidden" type="checkbox" /></label>
      </div>
      <div class="field-row">
        <label>Size<select id="cfg-size">
          <option value="500">500 px</option>
          <option value="800">800 px</option>
          <option value="1000" selected>1000 px</option>
          <option value="1500">1500 px</option>
        </select></label>
        <label>Error correction<select id="cfg-ec">
          <option value="L">L — ~7%</option>
          <option value="M" selected>M — ~15%</option>
          <option value="Q">Q — ~25%</option>
          <option value="H">H — ~30%</option>
        </select></label>
      </div>
      <label>Output format
        <div class="seg" id="format-seg">
          <button type="button" data-format="svg" class="is-active">SVG</button>
          <button type="button" data-format="png">PNG</button>
        </div>
      </label>
      <label class="toggle-row">
        <span>Include quiet zone</span>
        <input id="cfg-quietzone" type="checkbox" checked />
      </label>
      <label>File naming<input id="cfg-pattern" type="text" placeholder="{filename}" /></label>
      <div class="logo-row">
        <label class="logo-label" for="cfg-logo">
          Logo overlay (optional, applied to every code) <em>— Pro feature</em>
          <input id="cfg-logo" type="file" accept="image/png,image/jpeg,image/webp,image/svg+xml" disabled />
        </label>
        <div class="logo-controls" id="cfg-logo-controls" hidden>
          <label>Logo size<select id="cfg-logo-scale">
            <option value="0.16">Small</option>
            <option value="0.22" selected>Medium</option>
            <option value="0.28">Large</option>
          </select></label>
          <button id="cfg-logo-remove" class="btn" type="button">Remove logo</button>
        </div>
        <p class="logo-note" id="cfg-logo-note" hidden>Logo added — error correction bumped to H so every code still scans reliably.</p>
        <p class="logo-note" id="cfg-logo-locked">Unlock Pro to add a logo to every code in this batch.</p>
      </div>
    </div>
  </section>

  <section id="preview" class="panel">
    <h2><span class="pn">04</span>Preview <span id="preview-count" class="preview-count"></span></h2>
    <div id="preview-list" class="preview-list">
      <p class="empty-note">Upload a CSV to see a live preview here.</p>
    </div>
    <button id="preview-toggle" class="btn preview-toggle" type="button" hidden>View all rows</button>
  </section>
</div>

<div class="generate-bar">
  <div class="gb-left">
    <strong id="ready-count">Upload a CSV to get started</strong>
    <div class="chips">
      <span id="chip-format">SVG</span>
      <span id="chip-size">1000×1000</span>
      <span id="chip-ec">M (~15%)</span>
      <span>ZIP output</span>
    </div>
  </div>
  <div class="gb-right">
    <span id="gen-progress" class="gen-progress" aria-live="polite"></span>
    <button id="generate-btn" class="btn btn-accent" type="button" disabled>Generate QR codes</button>
  </div>
</div>

<div id="upsell-cta" class="upsell-cta" hidden>
  <div class="upsell-text">
    <strong id="upsell-title">More QR codes waiting</strong>
    <span>You've got the free 50 — unlock the rest of this exact batch, or go unlimited for every future one.</span>
  </div>
  <div class="upsell-actions">
    <button id="upsell-buy-batch" class="btn btn-fill" type="button">Finish this batch — $7</button>
    <button id="upsell-buy-pro" class="btn btn-accent" type="button">Go unlimited — $39</button>
  </div>
</div>

<p class="gb-note">Generation happens entirely in this browser tab — nothing is uploaded anywhere.</p>

<div class="support-grid">
  <section class="support-col">
    <h2>How it works</h2>
    <ol class="how-list">
      <li>Drop in a CSV — the columns are read automatically, nothing leaves this tab.</li>
      <li>Check the auto-guessed column mapping in step 02, or fix it if it guessed wrong.</li>
      <li>Set your format, size, and filename pattern in step 03.</li>
      <li>Check the live preview in step 04, then generate the full batch as a ZIP.</li>
    </ol>
  </section>
  <section class="support-col">
    <h2>Tips for large batches</h2>
    <ul class="tips-list">
      <li>Export from Excel or Google Sheets as <strong>CSV</strong>, not .xlsx — direct Excel file support isn't built yet.</li>
      <li>Check the preview before generating the full batch — it's faster to fix a wrong column mapping on 3 rows than on 3,000.</li>
      <li>For labels that need to survive handling or dirt (warehouse tags, outdoor signage), bump error correction up to Q or H.</li>
      <li>Very large batches (5,000+ rows) take a little while to zip — leave the tab open and watch the progress counter rather than refreshing.</li>
    </ul>
  </section>
</div>

<div class="support-faq">
  <h2>Questions</h2>
  <details class="faq-item">
    <summary>What columns does my CSV need?</summary>
    <p>At minimum, one column with the QR content (a URL or any text). Filename, caption, price and category are all optional and only used if you map them.</p>
  </details>
  <details class="faq-item">
    <summary>What happens if a row is missing the QR data value?</summary>
    <p>That row is skipped — it won't produce an empty or broken QR code in your ZIP.</p>
  </details>
  <details class="faq-item">
    <summary>Can two rows end up with the same filename?</summary>
    <p>No — if your filename pattern would produce a duplicate, a number is automatically appended (like SKU001-1.svg) so nothing gets overwritten.</p>
  </details>
  <details class="faq-item">
    <summary>How many rows can this actually handle?</summary>
    <p>There's no hard limit built into the tool. Since it all runs in your browser tab rather than on a server, very large batches are limited by your device's memory, not by us — a few thousand rows runs comfortably on a typical laptop.</p>
  </details>
  <details class="faq-item">
    <summary>My product names have commas in them — will that break the mapping?</summary>
    <p>No, as long as that field is wrapped in quotes in the CSV, which Excel and Google Sheets do automatically when a cell contains a comma.</p>
  </details>
  <details class="faq-item">
    <summary>Can I generate WiFi or vCard-formatted codes in bulk?</summary>
    <p>Yes — pick WiFi or vCard as the QR code type in step 03, then map the relevant columns (SSID/password for WiFi, name/company/phone/etc. for vCard) in step 02. Each row is built to the real WiFi or vCard 3.0 format, the same as the individual <a href="/wifi-qr-code-generator">WiFi</a> and <a href="/vcard-qr-code-generator">vCard</a> generators produce.</p>
  </details>
  <details class="faq-item">
    <summary>Can I add a logo to every code in a batch?</summary>
    <p>Yes, on Pro — upload a logo in step 03 and it's overlaid on every code in the batch, the same way the individual generators do it. Error correction is bumped to H automatically so the codes still scan reliably with a logo covering part of the pattern.</p>
  </details>
</div>

<script>
  import { renderQR, qrToSVGString, qrToPNGBlob } from "../lib/qr.js";
  import { parseCSV, guessColumn, buildFilename } from "../lib/csv.js";
  import { buildWifiPayload, buildVCardPayload } from "../lib/formats.js";
  import {
    newJobId,
    jobIdFromFile,
    startCheckout,
    resolvePendingCheckout,
    redeemLicenseKey,
    requestLicenseRecovery,
    getStoredPayment,
    clearStoredPayment,
    verifyAccessForJob,
  } from "../lib/bulk/license.js";
  import JSZip from "jszip";

  const FREE_ROW_CAP = 20;
  // A Batch Pass covers one file up to this many rows (matches the "$7, up
  // to 5,000 codes" claim on pricing.astro / PricingCards.astro) -- Pro has
  // no cap at all. Kept as one function so every place that checks "how many
  // rows can this tier actually generate" stays in sync with what's sold.
  const BATCH_ROW_CAP = 5000;
  function effectiveCap() {
    if (activeTier === "pro") return Infinity;
    if (activeTier === "batch") return BATCH_ROW_CAP;
    return FREE_ROW_CAP;
  }

  const el = (id) => document.getElementById(id);
  const dropzone = el("dropzone");
  const fileInput = el("file-input");
  const fileInfo = el("file-info");
  const errorBanner = el("error-banner");

  const upsell = {
    root: el("upsell-cta"),
    title: el("upsell-title"),
    buyBatch: el("upsell-buy-batch"),
    buyPro: el("upsell-buy-pro"),
  };

  const tierBanner = {
    title: el("tb-title"),
    desc: el("tb-desc"),
    actions: el("tb-actions"),
    buyBatch: el("tb-buy-batch"),
    buyPro: el("tb-buy-pro"),
    toggleKey: el("tb-toggle-key"),
    changeKey: el("tb-change-key"),
    keyForm: el("tb-key-form"),
    keyInput: el("tb-key-input"),
    keyError: el("tb-key-error"),
    toggleRecover: el("tb-toggle-recover"),
    recoverForm: el("tb-recover-form"),
    recoverEmail: el("tb-recover-email"),
    recoverStatus: el("tb-recover-status"),
  };

  function tierLabel(tier) {
    return tier === "pro" ? "Pro (lifetime)" : tier === "batch" ? "Batch Pass" : "Unlocked";
  }

  let isUnlocked = false;
  let activeTier = null;
  let jobId = null;

  function renderTierBanner() {
    tierBanner.keyForm.hidden = true;
    tierBanner.recoverForm.hidden = true;
    const stored = getStoredPayment();
    // A Batch Pass bought with no file loaded (or before this file matched
    // it) sits here: really paid, not yet claimed by a specific upload.
    // Showing buy buttons in that state reads as "the payment didn't work" --
    // it didn't fail, it just isn't scoped to anything yet.
    const pendingClaim = !isUnlocked && stored?.tier === "batch" && !stored.jobId;

    if (isUnlocked) {
      upsell.root.hidden = true;
      tierBanner.title.textContent = `${tierLabel(activeTier)} unlocked`;
      tierBanner.desc.textContent =
        activeTier === "batch"
          ? "Unlocked for this file. Buy another Batch Pass for a different one, or upgrade to Pro for unlimited."
          : "Unlimited batches, on any device with your license key.";
      tierBanner.buyBatch.hidden = true;
      tierBanner.buyPro.hidden = true;
      tierBanner.toggleKey.hidden = true;
      // Pro is the top tier -- there's nothing to switch "up" to, and
      // offering to swap keys here just invites someone to click it and
      // land on a screen with a $39 buy button, which reads as "pay again"
      // right after they already paid. Batch Pass still shows it, since
      // switching to a different file's key or upgrading to Pro both make
      // real sense there.
      tierBanner.changeKey.hidden = activeTier === "pro";
    } else if (pendingClaim) {
      tierBanner.title.textContent = "Batch Pass confirmed";
      tierBanner.desc.textContent = "Not tied to a file yet — upload yours below and it unlocks automatically. We've also emailed you the license key.";
      tierBanner.buyBatch.hidden = true;
      tierBanner.buyPro.hidden = true;
      tierBanner.toggleKey.hidden = true;
      tierBanner.changeKey.hidden = false;
    } else {
      tierBanner.title.textContent = "Free plan";
      tierBanner.desc.textContent = `Up to ${FREE_ROW_CAP} QR codes per batch, then upgrade for unlimited.`;
      // A Batch Pass is a downgrade from Pro -- don't offer it as a buy
      // option once this browser already holds a valid Pro purchase, even
      // mid "use a different license key" (that only resets the on-screen
      // state, not the underlying stored payment).
      tierBanner.buyBatch.hidden = stored?.tier === "pro";
      tierBanner.buyPro.hidden = false;
      tierBanner.toggleKey.hidden = false;
      tierBanner.changeKey.hidden = true;
    }
    updateLogoLock();
    updateBottomBar();
  }

  tierBanner.changeKey.addEventListener("click", () => {
    if (!isUnlocked) {
      // Only reachable from the pending-claim state (an unclaimed Batch
      // Pass) -- nothing is actually unlocked yet, so there's nothing lost
      // by clearing it here; "Forgot your key?" can always re-send it.
      clearStoredPayment();
    }
    isUnlocked = false;
    activeTier = null;
    renderTierBanner();
    tierBanner.keyForm.hidden = false;
  });

  tierBanner.toggleKey.addEventListener("click", () => {
    tierBanner.keyForm.hidden = !tierBanner.keyForm.hidden;
    tierBanner.recoverForm.hidden = true;
  });

  tierBanner.toggleRecover.addEventListener("click", () => {
    tierBanner.recoverForm.hidden = !tierBanner.recoverForm.hidden;
  });

  tierBanner.buyBatch.addEventListener("click", async () => {
    // jobId may be null here if no file is loaded yet -- that's fine, the
    // purchase just stays unscoped at Dodo until it's claimed by whichever
    // file it's first used on (see verifyAccessForJob in lib/bulk/license.js).
    tierBanner.buyBatch.disabled = true;
    try {
      saveResumeState();
      await startCheckout("batch", jobId);
    } catch (err) {
      tierBanner.keyError.textContent = err.message;
      tierBanner.keyError.hidden = false;
      tierBanner.keyForm.hidden = false;
      tierBanner.buyBatch.disabled = false;
    }
  });

  tierBanner.buyPro.addEventListener("click", async () => {
    tierBanner.buyPro.disabled = true;
    try {
      saveResumeState();
      await startCheckout("pro", jobId || newJobId());
    } catch (err) {
      tierBanner.keyError.textContent = err.message;
      tierBanner.keyError.hidden = false;
      tierBanner.keyForm.hidden = false;
      tierBanner.buyPro.disabled = false;
    }
  });

  tierBanner.keyForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const key = tierBanner.keyInput.value.trim();
    if (!key) return;
    tierBanner.keyError.hidden = true;
    try {
      const record = await redeemLicenseKey(key, jobId || "");
      isUnlocked = true;
      activeTier = record.tier;
      renderTierBanner();
    } catch (err) {
      tierBanner.keyError.textContent = err.message;
      tierBanner.keyError.hidden = false;
    }
  });

  tierBanner.recoverForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = tierBanner.recoverEmail.value.trim();
    if (!email) return;
    tierBanner.recoverStatus.hidden = true;
    try {
      const message = await requestLicenseRecovery(email);
      tierBanner.recoverStatus.textContent = message;
      tierBanner.recoverStatus.hidden = false;
    } catch (err) {
      tierBanner.recoverStatus.textContent = err.message;
      tierBanner.recoverStatus.hidden = false;
    }
  });

  // Re-checks access for whatever file is currently loaded. A Batch Pass
  // only ever unlocks the specific file it was bought for -- uploading a
  // different one correctly falls back to the free plan.
  async function refreshAccessForCurrentJob() {
    if (!jobId) return;
    const access = await verifyAccessForJob(jobId).catch(() => null);
    isUnlocked = Boolean(access);
    activeTier = access?.tier ?? null;
    renderTierBanner();
  }

  async function initTierBanner() {
    let resumed = null;
    try {
      resumed = await resolvePendingCheckout();
    } catch {
      resumed = { failed: true };
    }
    if (resumed?.failed) {
      showError("Payment wasn't completed — nothing was charged.");
    }
    // A confirmed batch purchase with no jobId yet renders via the
    // pending-claim branch in renderTierBanner() (derived from storage, not
    // from this one-time resolution), so there's nothing further to do for
    // that case here -- it stays correct across reloads, not just this visit.
    const stored = getStoredPayment();
    if (stored?.tier === "pro") {
      isUnlocked = true;
      activeTier = "pro";
    }
    renderTierBanner();
  }

  const mapSelects = {
    qrData: el("map-qrdata"),
    wifiSsid: el("map-wifi-ssid"),
    wifiPassword: el("map-wifi-password"),
    vcardFirst: el("map-vcard-first"),
    vcardLast: el("map-vcard-last"),
    vcardOrg: el("map-vcard-org"),
    vcardTitle: el("map-vcard-title"),
    vcardPhone: el("map-vcard-phone"),
    vcardEmail: el("map-vcard-email"),
    vcardUrl: el("map-vcard-url"),
    vcardAddress: el("map-vcard-address"),
    filename: el("map-filename"),
    caption: el("map-caption"),
    price: el("map-price"),
    category: el("map-category"),
  };
  // Selects that take an empty "None" option, not just a header guess --
  // required fields (SSID, first name, URL/plain-text data) always default
  // to some header since there's no meaningful "skip this" state for them.
  const OPTIONAL_MAP_KEYS = ["wifiPassword", "vcardLast", "vcardOrg", "vcardTitle", "vcardPhone", "vcardEmail", "vcardUrl", "vcardAddress", "caption", "price", "category"];

  const cfgType = el("cfg-type");
  const cfgWifiExtra = el("cfg-wifi-extra");
  const cfgWifiSecurity = el("cfg-wifi-security");
  const cfgWifiHidden = el("cfg-wifi-hidden");
  const cfgSize = el("cfg-size");
  const cfgEc = el("cfg-ec");
  const cfgQuietZone = el("cfg-quietzone");
  const cfgPattern = el("cfg-pattern");
  const formatSeg = el("format-seg");

  const cfgLogo = el("cfg-logo");
  const cfgLogoControls = el("cfg-logo-controls");
  const cfgLogoScale = el("cfg-logo-scale");
  const cfgLogoRemove = el("cfg-logo-remove");
  const cfgLogoNote = el("cfg-logo-note");
  const cfgLogoLocked = el("cfg-logo-locked");
  let logoState = null; // { image, dataUrl } -- Pro-only, applied to every code in the batch

  const previewList = el("preview-list");
  const previewCount = el("preview-count");
  const previewToggle = el("preview-toggle");

  const readyCount = el("ready-count");
  const generateBtn = el("generate-btn");
  const genProgress = el("gen-progress");

  const ecLabel = { L: "~7%", M: "~15%", Q: "~25%", H: "~30%" };

  let state = { headers: [], rows: [] };
  let format = "svg";
  let previewExpanded = false;

  function showError(msg) {
    errorBanner.textContent = msg;
    errorBanner.hidden = false;
  }
  function clearError() {
    errorBanner.hidden = true;
  }

  function markStepDone(id) {
    const link = document.querySelector(`.side-link[data-step="${id}"]`);
    if (link) link.classList.add("is-done");
  }

  async function handleFile(file) {
    clearError();
    if (!/\.csv$/i.test(file.name)) {
      showError(`"${file.name}" isn't a CSV file. Export your spreadsheet as CSV and try again.`);
      return;
    }
    const text = await file.text();
    const { headers, rows } = parseCSV(text);
    if (headers.length === 0 || rows.length === 0) {
      showError("That CSV looks empty, or has no header row.");
      return;
    }
    state = { headers, rows };
    jobId = await jobIdFromFile(file);

    fileInfo.hidden = false;
    el("file-name").textContent = file.name;
    el("file-rows").textContent = `${rows.length.toLocaleString()} rows`;

    populateMapping();
    markStepDone("upload");
    markStepDone("map");
    markStepDone("configure");
    markStepDone("preview");
    renderPreview();
    updateBottomBar();
    await refreshAccessForCurrentJob();
    await tryResumeAfterCheckout();
  }

  function populateMapping() {
    const { headers } = state;
    const fileGuess = guessColumn(headers, ["sku", "id", "code"], headers[0]);
    const guesses = {
      qrData: guessColumn(headers, ["url", "link", "website"], headers[0]),
      wifiSsid: guessColumn(headers, ["ssid", "network", "wifi"], headers[0]),
      wifiPassword: guessColumn(headers, ["password", "pass", "pwd"]),
      vcardFirst: guessColumn(headers, ["first", "fname", "name"], headers[0]),
      vcardLast: guessColumn(headers, ["last", "lname", "surname"]),
      vcardOrg: guessColumn(headers, ["company", "org", "organization"]),
      vcardTitle: guessColumn(headers, ["title", "role", "position"]),
      vcardPhone: guessColumn(headers, ["phone", "tel", "mobile"]),
      vcardEmail: guessColumn(headers, ["email"]),
      vcardUrl: guessColumn(headers, ["website", "url", "site"]),
      vcardAddress: guessColumn(headers, ["address"]),
      filename: fileGuess,
      caption: guessColumn(headers, ["name", "product", "title", "caption"]),
      price: guessColumn(headers, ["price", "cost"]),
      category: guessColumn(headers, ["category", "type"]),
    };

    for (const [key, sel] of Object.entries(mapSelects)) {
      const guess = guesses[key];
      const noneOption = OPTIONAL_MAP_KEYS.includes(key) ? `<option value="">None</option>` : "";
      sel.innerHTML = noneOption + headers.map((h) => `<option ${h === guess ? "selected" : ""}>${h}</option>`).join("");
      sel.disabled = false;
    }
    cfgPattern.value = `{${fileGuess}}`;
    updateMapVisibility();
  }

  // Only the field group matching the selected QR type is shown -- the rest
  // stay populated in the background so switching types back and forth
  // doesn't lose whatever was already mapped.
  function updateMapVisibility() {
    document.querySelectorAll(".map-group").forEach((g) => {
      g.hidden = g.dataset.type !== cfgType.value;
    });
    cfgWifiExtra.hidden = cfgType.value !== "wifi";
  }

  function currentMapping() {
    const m = {};
    for (const key of Object.keys(mapSelects)) m[key] = mapSelects[key].value;
    return m;
  }

  // Builds the actual QR payload for one row, per the selected type -- the
  // same encoders the individual WiFi/vCard generators use, so a bulk WiFi
  // or vCard code is byte-for-byte the same format as a hand-made one.
  function buildQRValue(mapping, row) {
    if (cfgType.value === "wifi") {
      return buildWifiPayload({
        ssid: row[mapping.wifiSsid] || "",
        password: mapping.wifiPassword ? row[mapping.wifiPassword] || "" : "",
        security: cfgWifiSecurity.value,
        hidden: cfgWifiHidden.checked,
      });
    }
    if (cfgType.value === "vcard") {
      return buildVCardPayload({
        firstName: row[mapping.vcardFirst] || "",
        lastName: mapping.vcardLast ? row[mapping.vcardLast] || "" : "",
        org: mapping.vcardOrg ? row[mapping.vcardOrg] || "" : "",
        title: mapping.vcardTitle ? row[mapping.vcardTitle] || "" : "",
        phone: mapping.vcardPhone ? row[mapping.vcardPhone] || "" : "",
        email: mapping.vcardEmail ? row[mapping.vcardEmail] || "" : "",
        url: mapping.vcardUrl ? row[mapping.vcardUrl] || "" : "",
        address: mapping.vcardAddress ? row[mapping.vcardAddress] || "" : "",
      });
    }
    return row[mapping.qrData] || "";
  }

  function renderPreview() {
    const mapping = currentMapping();
    const limit = previewExpanded ? state.rows.length : Math.min(3, state.rows.length);
    previewList.innerHTML = "";
    state.rows.slice(0, limit).forEach((row) => {
      const item = document.createElement("div");
      item.className = "preview-item";
      const canvas = document.createElement("canvas");
      canvas.width = 200;
      canvas.height = 200;
      item.appendChild(canvas);
      const text = document.createElement("div");
      const parts = [mapping.caption && row[mapping.caption], mapping.price && row[mapping.price]].filter(Boolean);
      text.innerHTML = `<strong>${buildFilename(cfgPattern.value || "{" + mapping.filename + "}", row, state.headers)}</strong><span>${parts.join(" · ") || "&nbsp;"}</span>`;
      item.appendChild(text);
      previewList.appendChild(item);
      const value = buildQRValue(mapping, row);
      if (value) renderQR(canvas, value, { width: 200, margin: 1, logo: activeLogo() });
    });
    previewCount.textContent = state.rows.length
      ? previewExpanded
        ? `— all ${state.rows.length}`
        : `— first ${limit} of ${state.rows.length}`
      : "";
    previewToggle.hidden = state.rows.length <= 3;
    previewToggle.textContent = previewExpanded ? "Show fewer" : "View all rows";
  }

  function updateBottomBar() {
    const n = state.rows.length;
    const cap = effectiveCap();
    const capped = n > cap;
    if (!n) {
      readyCount.textContent = "Upload a CSV to get started";
    } else if (capped) {
      const capReason = activeTier === "batch" ? "this Batch Pass covers a file up to" : "free plan caps batches at";
      readyCount.textContent = `${cap.toLocaleString()} of ${n.toLocaleString()} QR codes ready — ${capReason} ${cap.toLocaleString()}`;
    } else {
      readyCount.textContent = `${n.toLocaleString()} QR codes ready to generate`;
    }
    el("chip-format").textContent = format.toUpperCase();
    el("chip-size").textContent = `${cfgSize.value}×${cfgSize.value}`;
    el("chip-ec").textContent = `${cfgEc.value} (${ecLabel[cfgEc.value]})`;
    generateBtn.disabled = n === 0;
    generateBtn.textContent = capped
      ? `Generate ${cap.toLocaleString()} of ${n.toLocaleString()} (${activeTier === "batch" ? "batch limit" : "free limit"})`
      : n
        ? `Generate ${n.toLocaleString()} QR codes`
        : "Generate QR codes";
  }

  dropzone.addEventListener("click", () => fileInput.click());
  dropzone.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === " ") {
      e.preventDefault();
      fileInput.click();
    }
  });
  dropzone.addEventListener("dragover", (e) => {
    e.preventDefault();
    dropzone.classList.add("is-drag");
  });
  dropzone.addEventListener("dragleave", () => dropzone.classList.remove("is-drag"));
  dropzone.addEventListener("drop", (e) => {
    e.preventDefault();
    dropzone.classList.remove("is-drag");
    const file = e.dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });
  fileInput.addEventListener("change", () => {
    const file = fileInput.files?.[0];
    if (file) handleFile(file);
  });

  el("sample-csv").addEventListener("click", () => {
    // 75 rows -- comfortably over the 50-code free cap, so uploading this
    // as-is demonstrates the free/paid boundary through the real UI instead
    // of needing devtools to fake a bigger file.
    const colors = ["Blue", "Red", "Green", "Black", "White", "Gray", "Navy", "Yellow", "Purple", "Orange"];
    const types = ["Cotton T-Shirt", "Hoodie", "Cap", "Tote Bag", "Mug", "Sticker Pack", "Notebook", "Water Bottle"];
    const combos = [];
    for (const type of types) {
      for (const color of colors) combos.push({ color, type });
    }
    const lines = ["SKU,Product,URL"];
    combos.slice(0, 75).forEach((c, i) => {
      const sku = `SKU${String(i + 1).padStart(3, "0")}`;
      const slug = `${c.color.toLowerCase()}-${c.type.toLowerCase().replace(/\s+/g, "-")}`;
      lines.push(`${sku},${c.color} ${c.type},https://example.com/products/${slug}`);
    });
    const sample = lines.join("\n");
    const blob = new Blob([sample], { type: "text/csv" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "sample-products.csv";
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  });
  el("replace-file").addEventListener("click", () => fileInput.click());

  Object.values(mapSelects).forEach((sel) => sel.addEventListener("change", () => { renderPreview(); }));
  cfgPattern.addEventListener("input", () => renderPreview());
  cfgSize.addEventListener("change", updateBottomBar);
  cfgEc.addEventListener("change", updateBottomBar);
  cfgType.addEventListener("change", () => {
    updateMapVisibility();
    renderPreview();
  });
  cfgWifiSecurity.addEventListener("change", () => renderPreview());
  cfgWifiHidden.addEventListener("change", () => renderPreview());

  const MAX_LOGO_BYTES = 2 * 1024 * 1024;
  function fileToDataURL(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(reader.result);
      reader.onerror = () => reject(reader.error);
      reader.readAsDataURL(file);
    });
  }
  function loadImage(dataUrl) {
    return new Promise((resolve, reject) => {
      const img = new Image();
      img.onload = () => resolve(img);
      img.onerror = () => reject(new Error("Could not read that image file"));
      img.src = dataUrl;
    });
  }
  // Logo is Pro-only -- returns null (no overlay) unless the current
  // browser holds an unlocked Pro purchase, even if a file was chosen
  // before the input got locked back down (e.g. switching license keys).
  function activeLogo() {
    if (!logoState || activeTier !== "pro") return null;
    return { image: logoState.image, dataUrl: logoState.dataUrl, scale: Number(cfgLogoScale.value), backdrop: "#ffffff" };
  }
  // Enables/disables the logo upload based on the current tier -- called
  // from renderTierBanner() so it stays in sync with every unlock/lock
  // transition (buy, redeem, switch key) without duplicating that logic.
  function updateLogoLock() {
    const unlockedPro = isUnlocked && activeTier === "pro";
    cfgLogo.disabled = !unlockedPro;
    cfgLogoLocked.hidden = unlockedPro;
    if (!unlockedPro && logoState) {
      logoState = null;
      cfgLogo.value = "";
      cfgLogoControls.hidden = true;
      cfgLogoNote.hidden = true;
      renderPreview();
    }
  }
  cfgLogo.addEventListener("change", async () => {
    const file = cfgLogo.files[0];
    if (!file) return;
    if (file.size > MAX_LOGO_BYTES) {
      alert("Logo must be under 2MB.");
      cfgLogo.value = "";
      return;
    }
    try {
      const dataUrl = await fileToDataURL(file);
      const image = await loadImage(dataUrl);
      logoState = { image, dataUrl };
      cfgLogoControls.hidden = false;
      cfgLogoNote.hidden = false;
      renderPreview();
    } catch {
      alert("Could not read that image file.");
      cfgLogo.value = "";
    }
  });
  cfgLogoRemove.addEventListener("click", () => {
    logoState = null;
    cfgLogo.value = "";
    cfgLogoControls.hidden = true;
    cfgLogoNote.hidden = true;
    renderPreview();
  });
  cfgLogoScale.addEventListener("change", () => renderPreview());
  formatSeg.addEventListener("click", (e) => {
    const btn = e.target.closest("button[data-format]");
    if (!btn) return;
    formatSeg.querySelectorAll("button").forEach((b) => b.classList.remove("is-active"));
    btn.classList.add("is-active");
    format = btn.dataset.format;
    updateBottomBar();
  });
  previewToggle.addEventListener("click", () => {
    previewExpanded = !previewExpanded;
    renderPreview();
  });

  async function runGenerateAll() {
    if (!state.rows.length) return;
    generateBtn.disabled = true;
    upsell.root.hidden = true;
    const mapping = currentMapping();
    const size = Number(cfgSize.value);
    const ec = cfgEc.value;
    const margin = cfgQuietZone.checked ? 4 : 0;
    const pattern = cfgPattern.value || `{${mapping.filename}}`;
    const zip = new JSZip();
    const used = new Set();
    let written = 0;

    const cap = effectiveCap();
    const capped = state.rows.length > cap;
    const rows = capped ? state.rows.slice(0, cap) : state.rows;

    const logo = activeLogo();
    // A logo covering part of the pattern needs a higher error-correction
    // floor to stay scannable -- same rule the single-code generators use.
    const effectiveEc = logo && (ec === "L" || ec === "M") ? "H" : ec;

    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const value = buildQRValue(mapping, row);
      if (!value) continue;
      let name = buildFilename(pattern, row, state.headers) + "." + format;
      let n = 1;
      while (used.has(name)) {
        name = name.replace(/(\.[a-z]+)$/i, `-${n}$1`);
        n++;
      }
      used.add(name);

      if (format === "svg") {
        const svg = await qrToSVGString(value, { errorCorrectionLevel: effectiveEc, margin, width: size, logo });
        zip.file(name, svg);
      } else {
        const blob = await qrToPNGBlob(value, { errorCorrectionLevel: effectiveEc, margin, width: size, logo });
        zip.file(name, blob);
      }
      written++;
      if (i % 20 === 0) {
        genProgress.textContent = `Generating… ${i + 1}/${rows.length}`;
        await new Promise((r) => setTimeout(r, 0));
      }
    }

    genProgress.textContent = `Zipping ${written.toLocaleString()} files…`;
    await new Promise((r) => setTimeout(r, 0));
    const blob = await zip.generateAsync({ type: "blob" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = "qrgrid-codes.zip";
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    genProgress.textContent = capped
      ? `Done — downloaded ${written.toLocaleString()} of ${state.rows.length.toLocaleString()} (${activeTier === "batch" ? "batch limit is" : "free limit is"} ${cap.toLocaleString()}).`
      : `Done — downloaded qrgrid-codes.zip (${written.toLocaleString()} files)`;
    generateBtn.disabled = false;

    if (capped) {
      const remaining = state.rows.length - cap;
      upsell.title.textContent = `${remaining.toLocaleString()} more QR code${remaining === 1 ? "" : "s"} waiting`;
      // Already on a Batch Pass and still over its cap -- another Batch
      // Pass wouldn't help (it's scoped to one file, and this one is
      // already claimed), so Pro is the only real next step here.
      upsell.buyBatch.hidden = activeTier === "batch";
      upsell.root.hidden = false;
    }
  }

  generateBtn.addEventListener("click", runGenerateAll);

  upsell.buyBatch.addEventListener("click", async () => {
    upsell.buyBatch.disabled = true;
    try {
      saveResumeState();
      await startCheckout("batch", jobId);
    } catch (err) {
      showError(err.message);
      upsell.buyBatch.disabled = false;
    }
  });

  upsell.buyPro.addEventListener("click", async () => {
    upsell.buyPro.disabled = true;
    try {
      saveResumeState();
      await startCheckout("pro", jobId || newJobId());
    } catch (err) {
      showError(err.message);
      upsell.buyPro.disabled = false;
    }
  });

  // Regenerate flow: a Dodo checkout is a real page navigation away and
  // back, which wipes all in-memory state (the parsed file can't survive
  // that -- File objects aren't serializable). What IS possible: remember
  // the column mapping/format/size tied to this exact job just before
  // leaving for checkout, and once the customer re-uploads the same file
  // (jobId matches, since it's a content hash of the file), restore those
  // choices and run the full generate straight away instead of making them
  // redo the mapping step from scratch.
  const RESUME_KEY = "qrw_resume_after_checkout";
  function saveResumeState() {
    try {
      sessionStorage.setItem(
        RESUME_KEY,
        JSON.stringify({ jobId, mapping: currentMapping(), format, size: cfgSize.value, ec: cfgEc.value, quietZone: cfgQuietZone.checked, pattern: cfgPattern.value })
      );
    } catch {
      /* sessionStorage unavailable (private mode, etc.) -- resume just won't fire, no harder failure than that */
    }
  }
  function loadResumeState() {
    try {
      return JSON.parse(sessionStorage.getItem(RESUME_KEY) || "null");
    } catch {
      return null;
    }
  }
  function clearResumeState() {
    sessionStorage.removeItem(RESUME_KEY);
  }

  async function tryResumeAfterCheckout() {
    const resume = loadResumeState();
    if (!resume || resume.jobId !== jobId) return;
    clearResumeState();

    if (mapSelects.qrData.querySelector(`option[value="${CSS.escape(resume.mapping.qrData)}"]`)) mapSelects.qrData.value = resume.mapping.qrData;
    if (mapSelects.filename.querySelector(`option[value="${CSS.escape(resume.mapping.filename)}"]`)) mapSelects.filename.value = resume.mapping.filename;
    mapSelects.caption.value = resume.mapping.caption || "";
    mapSelects.price.value = resume.mapping.price || "";
    mapSelects.category.value = resume.mapping.category || "";
    cfgSize.value = resume.size;
    cfgEc.value = resume.ec;
    cfgQuietZone.checked = resume.quietZone;
    cfgPattern.value = resume.pattern;
    formatSeg.querySelectorAll("button").forEach((b) => b.classList.toggle("is-active", b.dataset.format === resume.format));
    format = resume.format;

    renderPreview();
    updateBottomBar();
    tierBanner.desc.textContent = "Welcome back — picking up where you left off.";
    await runGenerateAll();
  }

  // Carries size/error-correction/margin over from the homepage's free
  // generator ("Apply this design to a batch") -- only these three, since
  // they're the only settings that exist on both sides. Foreground/
  // background color and logo have no equivalent here yet, so there's
  // nothing honest to carry forward for those.
  //
  // `type` is separate: it's not a handoff from a prior design, just a deep
  // link so an SEO landing page (e.g. /bulk-vcard-qr-code-generator) can send
  // someone straight into the right QR-type mode instead of dumping them on
  // the URL default and making them find the vCard/WiFi option themselves.
  (function applyIncomingSettings() {
    const params = new URLSearchParams(window.location.search);
    const size = params.get("size");
    const ec = params.get("ec");
    const margin = params.get("margin");
    const type = params.get("type");

    if (type && [...cfgType.options].some((o) => o.value === type)) {
      cfgType.value = type;
      cfgType.dispatchEvent(new Event("change"));
    }

    if (size || ec || margin) {
      if (size && [...cfgSize.options].some((o) => o.value === size)) cfgSize.value = size;
      if (ec && [...cfgEc.options].some((o) => o.value === ec)) cfgEc.value = ec;
      if (margin !== null) cfgQuietZone.checked = margin !== "0";
      el("settings-note").hidden = false;
      updateBottomBar();
    }

    if (!size && !ec && !margin && !type) return;

    const url = new URL(window.location.href);
    ["size", "ec", "margin", "type"].forEach((k) => url.searchParams.delete(k));
    window.history.replaceState({}, "", url);
  })();

  updateBottomBar();
  initTierBanner();
</script>

<style>
  .ws-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .ws-head h1 { font-size: 1.55rem; margin: 0 0 0.4rem; letter-spacing: -0.01em; }
  .ws-head p { margin: 0; color: var(--ink-dim); font-size: 0.9rem; max-width: 48ch; }
  .privacy-box { display: flex; align-items: center; gap: 0.6rem; border: 1px solid var(--line); background: var(--surface); padding: 0.7rem 0.9rem; }
  .privacy-box strong { display: block; font-size: 0.78rem; }
  .privacy-box span { display: block; font-size: 0.68rem; color: var(--ink-faint); }

  .error-banner { border: 1px solid var(--red); background: #FDECE8; color: #9A2A14; padding: 0.75rem 1rem; font-size: 0.85rem; margin-bottom: 1.4rem; }
  .settings-note { border: 1px solid var(--ink); background: var(--surface); padding: 0.85rem 1.1rem; font-size: 0.85rem; margin-bottom: 1.4rem; }
  .settings-note strong { display: block; margin-bottom: 0.2rem; }

  .tier-banner {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    border: 1px solid var(--line); background: var(--surface); padding: 0.85rem 1.1rem; margin-bottom: 1.4rem;
  }
  .tb-status { display: flex; flex-direction: column; gap: 0.15rem; min-width: 0; }
  .tb-status strong { font-size: 0.85rem; }
  .tb-status span { font-size: 0.75rem; color: var(--ink-faint); }
  .tb-actions { display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap; }
  .tb-actions .btn { font-size: 0.76rem; padding: 0.55rem 0.9rem; }
  .link-btn { font: inherit; font-size: 0.78rem; background: none; border: none; color: var(--red); text-decoration: underline; cursor: pointer; padding: 0; }
  .tb-key-form { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; width: 100%; margin-top: 0.9rem; padding-top: 0.9rem; border-top: 1px solid var(--line); }
  .tb-key-form input { flex: 1; min-width: 180px; font: inherit; font-size: 0.82rem; padding: 0.55rem 0.7rem; border: 1px solid var(--line); background: var(--bg); color: var(--ink); }
  .tb-key-form .btn { font-size: 0.76rem; padding: 0.55rem 0.9rem; }
  .tb-key-error { color: var(--red); font-size: 0.78rem; margin: 0.6rem 0 0; width: 100%; }
  .tb-key-status { color: var(--success); font-size: 0.78rem; margin: 0.6rem 0 0; width: 100%; }
  #tb-buy-batch:disabled { opacity: 0.5; cursor: not-allowed; }

  .panels { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 1px solid var(--line); margin-bottom: 1.4rem; }
  .panel { position: relative; padding: 1.4rem; border-right: 1px solid var(--line); min-width: 0; }
  .panel:last-child { border-right: none; }
  .panel h2 { display: flex; align-items: center; gap: 0.55rem; font-size: 0.9rem; margin: 0 0 1.1rem; }

  /* Step connector: a small circle straddling the border between panels,
     with a chevron drawn from two rotated border edges -- reinforces that
     these four boxes are a sequence, not just a row of unrelated cards. */
  .panel:not(:last-child)::after {
    content: ""; position: absolute; top: 1.9rem; right: -13px; z-index: 2;
    width: 26px; height: 26px; border-radius: 50%; background: var(--bg); border: 1.5px solid var(--red);
  }
  .panel:not(:last-child)::before {
    content: ""; position: absolute; top: 2.55rem; right: -6px; z-index: 3;
    width: 7px; height: 7px; border-top: 1.5px solid var(--red); border-right: 1.5px solid var(--red);
    transform: rotate(45deg);
  }
  .pn { font-family: var(--mono); font-size: 0.68rem; color: var(--red); border: 1px solid var(--red); border-radius: 3px; padding: 0.1rem 0.35rem; }
  .preview-count { font-weight: 400; color: var(--ink-faint); font-size: 0.72rem; }

  .dropzone {
    border: 1.5px dashed var(--line); padding: 1.6rem 1rem; text-align: center; cursor: pointer;
    display: flex; flex-direction: column; align-items: center; gap: 0.6rem;
    transition: border-color var(--dur-fast) var(--ease-standard), background var(--dur-fast) var(--ease-standard);
  }
  .dropzone:hover, .dropzone.is-drag, .dropzone:focus-visible { border-color: var(--red); background: #FFF6F4; }
  .dropzone p { margin: 0; font-size: 0.82rem; line-height: 1.4; }
  .dropzone .hint { font-family: var(--mono); font-size: 0.65rem; color: var(--ink-faint); }

  .sample-link {
    display: block; width: 100%; margin-top: 0.7rem; padding: 0; border: none; background: none;
    font: inherit; font-size: 0.76rem; color: var(--red); text-decoration: underline; cursor: pointer; text-align: center;
  }

