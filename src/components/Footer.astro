---
import { TOOLS } from "../data/tools.js";
---
<footer class="site-footer">
  <div class="frame footer-brand-row">
    <span>QR Workbench — codes render in your browser and never touch our servers</span>
    <span>No account · No expiry · No dynamic redirects</span>
  </div>

  <div class="frame footer-grid">
    <div class="footer-col">
      <div class="footer-heading">Free tools</div>
      <nav aria-label="QR generators">
        {TOOLS.map((t) => <a href={t.href}>{t.name}</a>)}
      </nav>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Bulk</div>
      <nav aria-label="Bulk generation">
        <a href="/bulk-qr-code-generator">Bulk QR generator</a>
        <a href="/labels">Label generator</a>
        <a href="/pricing">Pricing</a>
      </nav>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Company</div>
      <nav aria-label="Company">
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
        <a href="/docs">Docs</a>
      </nav>
    </div>
    <div class="footer-col">
      <div class="footer-heading">Legal</div>
      <nav aria-label="Legal">
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms of Service</a>
        <a href="/disclaimer">Disclaimer</a>
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--ink); margin-top: 5rem; }
  .footer-brand-row {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    padding: 1.6rem 1.75rem 1.5rem;
    font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint);
    border-bottom: 1px solid var(--line);
  }
  .footer-grid {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem;
    padding: 2rem 1.75rem 2.5rem;
  }
  .footer-heading {
    font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.06em;
    color: var(--red); margin-bottom: 0.9rem;
  }
  .footer-col nav { display: flex; flex-direction: column; gap: 0.55rem; }
  .footer-col a { color: var(--ink-dim); text-decoration: none; font-size: 0.82rem; }
  .footer-col a:hover { color: var(--red); text-decoration: underline; }

  @media (max-width: 760px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 1.8rem; }
  }
  @media (max-width: 480px) {
    .footer-grid { grid-template-columns: 1fr; }
  }
</style>
