---
const { filenamePrefix = "qr-code" } = Astro.props;
---
<div class="tool-shell" data-filename-prefix={filenamePrefix}>
  <div class="tool-grid">
    <div class="tool-inputs">
      <slot name="fields" />
    </div>

    <div class="tool-preview">
      <div class="qr-panel">
        <span class="corner c-tl" aria-hidden="true"></span>
        <span class="corner c-tr" aria-hidden="true"></span>
        <span class="corner c-bl" aria-hidden="true"></span>
        <span class="corner c-br" aria-hidden="true"></span>
        <canvas id="qr-canvas" width="400" height="400" hidden aria-label="Generated QR code preview"></canvas>
        <p id="qr-empty" class="qr-empty">Fill in the fields to see a live preview.</p>
      </div>
      <div class="qr-meta-row" id="qr-meta-text"></div>

      <div class="ctrl-grid">
        <label>Foreground<input id="ctrl-fg" type="color" value="#111111" /></label>
        <label>Background<input id="ctrl-bg" type="color" value="#ffffff" /></label>
        <label class="ctrl-check"><input id="ctrl-transparent" type="checkbox" /> Transparent background</label>
        <label>Size<select id="ctrl-size">
          <option value="500">500 px</option>
          <option value="800" selected>800 px</option>
          <option value="1000">1000 px</option>
          <option value="1500">1500 px</option>
        </select></label>
        <label>Error correction<select id="ctrl-ecc">
          <option value="L">L — ~7%</option>
          <option value="M" selected>M — ~15%</option>
          <option value="Q">Q — ~25%</option>
          <option value="H">H — ~30%</option>
        </select></label>
        <label class="ctrl-check"><input id="ctrl-margin" type="checkbox" checked /> Include quiet zone</label>
      </div>

      <div class="dl-row">
        <button id="dl-png" class="btn btn-fill" type="button" disabled>Download PNG</button>
        <button id="dl-svg" class="btn" type="button" disabled>Download SVG</button>
      </div>

      <ul class="badge-row">
        <li>Static</li>
        <li>No expiry</li>
        <li>No redirect</li>
        <li>Generated in your browser</li>
      </ul>
    </div>
  </div>
</div>

<style>
  .tool-shell { border: 1px solid var(--line); background: var(--surface); padding: 1.8rem; margin: 2rem 0 2.6rem; }
  .tool-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 2.4rem; align-items: start; }

  .tool-inputs :global(label) { display: flex; flex-direction: column; gap: 0.35rem; font-size: 0.78rem; font-weight: 600; color: var(--ink-dim); margin-bottom: 1rem; }
  .tool-inputs :global(label em) { font-weight: 400; font-style: normal; color: var(--ink-faint); }
  .tool-inputs :global(input[type="text"]),
  .tool-inputs :global(input[type="url"]),
  .tool-inputs :global(input[type="tel"]),
  .tool-inputs :global(input[type="email"]),
  .tool-inputs :global(textarea),
  .tool-inputs :global(select) {
    font: inherit; font-size: 0.88rem; padding: 0.65rem 0.7rem; border: 1px solid var(--line); background: var(--bg); color: var(--ink);
  }
  .tool-inputs :global(textarea) { resize: vertical; min-height: 70px; }
  .tool-inputs :global(.field-row) { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .tool-inputs :global(.field-row) label { margin-bottom: 0; }
  .tool-inputs :global(.check-row) { flex-direction: row !important; align-items: center; gap: 0.5rem !important; }

  .qr-panel {
    position: relative; aspect-ratio: 1; max-width: 280px; margin: 0 auto;
    display: flex; align-items: center; justify-content: center; padding: 1.2rem;
    background-image: radial-gradient(var(--line) 1px, transparent 1px);
    background-size: 14px 14px;
    border: 1px solid var(--line);
  }
  .qr-panel canvas { width: 100%; height: auto; background: var(--surface); }
  .qr-empty { font-size: 0.78rem; color: var(--ink-faint); text-align: center; padding: 0 1rem; margin: 0; }
  .qr-panel .corner { position: absolute; width: 20px; height: 20px; }
  .qr-panel .corner::before, .qr-panel .corner::after { content: ""; position: absolute; background: var(--red); }
  .qr-panel .corner::before { width: 100%; height: 2px; }
  .qr-panel .corner::after { width: 2px; height: 100%; }
  .c-tl { top: 6px; left: 6px; } .c-tl::before, .c-tl::after { top: 0; left: 0; }
  .c-tr { top: 6px; right: 6px; } .c-tr::before, .c-tr::after { top: 0; right: 0; }
  .c-bl { bottom: 6px; left: 6px; } .c-bl::before, .c-bl::after { bottom: 0; left: 0; }
  .c-br { bottom: 6px; right: 6px; } .c-br::before, .c-br::after { bottom: 0; right: 0; }

  .qr-meta-row { text-align: center; font-family: var(--mono); font-size: 0.68rem; color: var(--ink-faint); margin: 0.7rem 0 1.3rem; min-height: 1em; }

  .ctrl-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.8rem 1rem; margin-bottom: 1.3rem; }
  .ctrl-grid label { display: flex; flex-direction: column; gap: 0.3rem; font-size: 0.72rem; font-weight: 600; color: var(--ink-dim); }
  .ctrl-grid select { font: inherit; font-size: 0.8rem; padding: 0.5rem 0.6rem; border: 1px solid var(--line); background: var(--bg); color: var(--ink); }
  .ctrl-grid input[type="color"] { width: 100%; height: 34px; border: 1px solid var(--line); padding: 2px; background: var(--bg); }
  .ctrl-check { flex-direction: row !important; align-items: center; gap: 0.5rem !important; grid-column: span 2; }
  .ctrl-check input { width: 16px; height: 16px; accent-color: var(--red); }

  .dl-row { display: flex; gap: 0.7rem; margin-bottom: 1.3rem; }
  .dl-row .btn { flex: 1; text-align: center; font-size: 0.8rem; padding: 0.7rem; }

  .badge-row { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .badge-row li { font-family: var(--mono); font-size: 0.62rem; color: var(--ink-faint); border: 1px solid var(--line); padding: 0.25rem 0.5rem; }

  @media (max-width: 760px) {
    .tool-grid { grid-template-columns: 1fr; }
    .tool-inputs :global(.field-row) { grid-template-columns: 1fr; }
  }
</style>
