---
---
<header class="site-nav">
  <div class="frame nav-row">
    <a class="logo" href="/">
      <svg class="mark" width="22" height="22" viewBox="0 0 22 22" aria-hidden="true">
        <rect x="0" y="0" width="9" height="9" fill="var(--ink)" />
        <rect x="13" y="0" width="9" height="9" fill="var(--red)" />
        <rect x="0" y="13" width="9" height="9" fill="var(--red)" />
        <rect x="13" y="13" width="9" height="9" fill="var(--ink)" />
      </svg>
      <span>QR<b>GRID</b></span>
    </a>

    <nav aria-label="Primary" class="primary-nav">
      <a href="/#tools">Tools <span class="badge badge-soon">SOON</span></a>
      <a href="/bulk">Bulk Generator <span class="badge">PRO</span></a>
      <a href="/labels">Label Generator <span class="badge badge-soon">SOON</span></a>
      <a href="/#pricing">Pricing</a>
      <a href="/docs">Docs</a>
    </nav>

    <div class="nav-right">
      <div class="privacy-indicator" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5 13.5 3.6v3.9c0 3.4-2.3 6.3-5.5 7-3.2-.7-5.5-3.6-5.5-7V3.6L8 1.5Z" stroke="var(--ink)" stroke-width="1.3" stroke-linejoin="round"/></svg>
        <span>
          <b>100% Private</b>
          <em>All in-browser</em>
        </span>
      </div>
      <a class="btn btn-accent nav-cta" href="/bulk">Upgrade to Pro</a>
    </div>
  </div>
</header>

<style>
  .site-nav { border-bottom: 1px solid var(--ink); background: var(--bg); }
  .nav-row { display: flex; align-items: center; gap: 2.25rem; padding: 1rem 1.75rem; }

  .logo { display: flex; align-items: center; gap: 0.55rem; margin-right: auto; text-decoration: none; color: var(--ink); }
  .logo .mark { flex: none; }
  .logo span { font-weight: 700; font-size: 1.05rem; letter-spacing: -0.01em; }
  .logo b { color: var(--red); font-weight: 800; }

  .primary-nav { display: flex; align-items: center; gap: 1.9rem; font-size: 0.84rem; font-weight: 500; }
  .primary-nav > a { color: var(--ink-dim); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; }
  .primary-nav > a:hover { color: var(--ink); }

  .badge { background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.04em; padding: 0.18rem 0.4rem; border-radius: 3px; }
  .badge-soon { background: var(--line); color: var(--ink-dim); }

  .nav-right { display: flex; align-items: center; gap: 1.4rem; }
  .privacy-indicator { display: flex; align-items: center; gap: 0.5rem; }
  .privacy-indicator span { display: flex; flex-direction: column; line-height: 1.2; }
  .privacy-indicator b { font-size: 0.72rem; }
  .privacy-indicator em { font-style: normal; font-size: 0.65rem; color: var(--ink-faint); }
  .nav-cta { font-size: 0.8rem; padding: 0.65rem 1.15rem; white-space: nowrap; }

  @media (max-width: 980px) {
    .privacy-indicator { display: none; }
  }
  @media (max-width: 860px) {
    .nav-row { flex-wrap: wrap; row-gap: 0.9rem; }
    .primary-nav { order: 3; flex-basis: 100%; flex-wrap: wrap; gap: 1rem 1.4rem; }
  }
</style>
