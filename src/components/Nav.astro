---
<header class="site-nav">
  <div class="frame nav-row">
    <a class="logo" href="/">
      <picture>
        <source srcset="/logo.webp" type="image/webp" />
        <img src="/logo.png" width="900" height="156" alt="QR Workbench" />
      </picture>
    </a>

    <nav aria-label="Primary" class="primary-nav">
      <details class="nav-drop">
        <summary>Tools</summary>
        <div class="drop-panel">
          <a href="/url-qr-code-generator">URL QR</a>
          <a href="/wifi-qr-code-generator">WiFi QR</a>
          <a href="/vcard-qr-code-generator">vCard QR</a>
          <a href="/email-qr-code-generator">Email QR</a>
          <a href="/sms-qr-code-generator">SMS QR</a>
          <a href="/phone-qr-code-generator">Phone QR</a>
          <a href="/pdf-qr-code-generator">PDF QR</a>
          <a href="/google-forms-qr-code-generator">Google Forms QR</a>
          <a href="/facebook-qr-code-generator">Facebook QR</a>
          <a href="/instagram-qr-code-generator">Instagram QR</a>
          <a href="/linkedin-qr-code-generator">LinkedIn QR</a>
        </div>
      </details>
      <a href="/bulk-qr-code-generator">Bulk Generator</a>
      <a href="/pricing">Pricing</a>
      <details class="nav-drop">
        <summary>More</summary>
        <div class="drop-panel drop-panel-single">
          <a href="/labels">Label Generator <span class="badge badge-soon">SOON</span></a>
          <a href="/docs">Docs</a>
        </div>
      </details>
    </nav>

    <div class="nav-right">
      <div class="privacy-indicator" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 1.5 13.5 3.6v3.9c0 3.4-2.3 6.3-5.5 7-3.2-.7-5.5-3.6-5.5-7V3.6L8 1.5Z" stroke="var(--ink)" stroke-width="1.3" stroke-linejoin="round"/></svg>
        <span>
          <b>100% Private</b>
          <em>All in-browser</em>
        </span>
      </div>
      <a class="btn btn-accent nav-cta" href="/pricing">Upgrade to Pro</a>
    </div>
  </div>
</header>

<style>
  .site-nav { border-bottom: 1px solid var(--ink); background: var(--bg); position: sticky; top: 0; z-index: 50; }
  /* Vertical padding trimmed to 1.15rem (from 1.55rem) so the row settles at
     ~85px tall with the logo's new 44px height -- the old padding was sized
     around the previous, much shorter logo. */
  .nav-row { display: flex; align-items: center; gap: 1.6rem; padding: 1.15rem 1.75rem; min-height: 84px; }

  /* Desktop: clamped 190-260px, preferring 24% of the nav row's width. The
     clamp() lives on .logo itself, not the <img> -- percentage widths only
     resolve against a containing block with a *definite* width, and .logo
     (a flex item of .nav-row, which has one) qualifies while <picture>/<img>
     alone wouldn't. The 24% (not the nominally "20%" target) is deliberate:
     .frame caps nav-row's content width at 1064px on every real desktop
     viewport, so the preferred term needs to land near the 260px ceiling to
     keep the logo's ~44px visible height at this fixed aspect ratio --
     literal 20% would plateau around 213px/37px tall instead. height:auto on
     the image (never a fixed height) is what keeps this from ever
     stretching or squashing the logo -- the browser derives height from the
     image's own aspect ratio at whatever width the clamp computes to. */
  .logo { display: flex; align-items: center; margin-right: auto; flex: none; width: clamp(190px, 24%, 260px); }
  .logo img { display: block; width: 100%; height: auto; }

  .primary-nav { display: flex; align-items: center; gap: 1.4rem; font-size: 0.84rem; font-weight: 500; flex: none; }
  .primary-nav > a { color: var(--ink-dim); text-decoration: none; display: inline-flex; align-items: center; gap: 0.4rem; white-space: nowrap; }
  .primary-nav > a:hover { color: var(--ink); }

  .badge { background: var(--ink); color: var(--bg); font-family: var(--mono); font-size: 0.58rem; font-weight: 700; letter-spacing: 0.04em; padding: 0.18rem 0.4rem; border-radius: 3px; }
  .badge-soon { background: var(--line); color: var(--ink-dim); }

  .nav-drop { position: relative; }
  .nav-drop summary { list-style: none; cursor: pointer; color: var(--ink-dim); display: inline-flex; align-items: center; gap: 0.35rem; white-space: nowrap; }
  .nav-drop summary::-webkit-details-marker { display: none; }
  .nav-drop summary::after { content: "▾"; font-size: 0.65rem; transition: transform var(--dur-fast) var(--ease-standard); }
  .nav-drop[open] summary::after { transform: rotate(180deg); }
  .nav-drop summary:hover { color: var(--ink); }
  .drop-panel {
    position: absolute; top: calc(100% + 0.9rem); left: -0.5rem; z-index: 40;
    background: var(--surface); border: 1px solid var(--ink); min-width: 190px;
    display: grid; grid-template-columns: repeat(2, 1fr); padding: 0.4rem;
    box-shadow: 4px 4px 0 var(--line);
  }
  .drop-panel-single { grid-template-columns: 1fr; min-width: 170px; }
  .drop-panel a { padding: 0.55rem 0.7rem; font-size: 0.8rem; color: var(--ink-dim); text-decoration: none; white-space: nowrap; display: flex; align-items: center; gap: 0.4rem; }
  .drop-panel a:hover { background: var(--bg); color: var(--ink); }

  .nav-right { display: flex; align-items: center; gap: 1.1rem; flex: none; }
  .privacy-indicator { display: flex; align-items: center; gap: 0.5rem; }
  .privacy-indicator span { display: flex; flex-direction: column; line-height: 1.2; }
  .privacy-indicator b { font-size: 0.72rem; white-space: nowrap; }
  .privacy-indicator em { font-style: normal; font-size: 0.65rem; color: var(--ink-faint); white-space: nowrap; }
  .nav-cta { font-size: 0.8rem; padding: 0.65rem 1.1rem; white-space: nowrap; }

  @media (max-width: 1200px) {
    .privacy-indicator { display: none; }
  }
  @media (max-width: 1060px) {
    .nav-row { flex-wrap: wrap; row-gap: 0.9rem; }
    .primary-nav { order: 3; flex-basis: 100%; flex-wrap: wrap; gap: 1rem 1.4rem; }
    .drop-panel { position: static; box-shadow: none; border: none; grid-template-columns: 1fr; padding: 0.2rem 0 0 0.8rem; }
  }

  /* Tablet: capped at 220px, preferring 34% (floored at the same 190px
     desktop starts from, so there's no size jump crossing this breakpoint
     from the desktop side). Unlike desktop, this row's width scales freely
     with the viewport (no .frame max-width ceiling in play here), so a
     modest percentage would drift down toward the 190px floor for most of
     the 601-900px band -- 34% instead keeps it saturated near the 220px
     ceiling (~38px visible height, close to the ~40px target) across most
     of that range. */
  @media (max-width: 900px) {
    .nav-row { padding: 1.15rem 1.5rem; min-height: 76px; }
    .logo { width: clamp(190px, 34%, 220px); }
  }

  /* Mobile: 150-190px, preferring 52% so ordinary phone widths (~375px+)
     saturate at the 190px ceiling, landing the visible height at ~33px --
     inside the 32-36px target -- rather than drifting toward 27-28px. */
  @media (max-width: 600px) {
    .nav-row { padding: 0.85rem 1.1rem; min-height: 64px; }
    .logo { width: clamp(150px, 52%, 190px); }
  }
</style>
