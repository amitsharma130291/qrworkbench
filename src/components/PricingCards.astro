---
const plans = [
  {
    name: "Free",
    price: "$0",
    note: "",
    features: ["Unlimited single codes", "Bulk batches up to 20 codes", "PNG + SVG export"],
    cta: "Start free",
    href: "/url-qr-code-generator",
    style: "",
  },
  {
    name: "Batch Pass",
    price: "$7",
    note: "once",
    features: ["One batch, up to 5,000 codes", "SVG + ZIP export", "Custom filenames"],
    // Direct checkout button (wired below), same as Pro. Ideally a Batch
    // Pass is scoped to one file, but that scoping can only be set at Dodo
    // checkout time -- bought from here with no file loaded yet, it stays
    // unscoped until claimed by whichever file it's first used on in the
    // bulk workspace.
    cta: "Buy a batch pass",
    href: null,
    action: "pricing-buy-batch",
    style: "",
  },
  {
    name: "Pro — lifetime",
    price: "$39",
    note: "once",
    features: ["Unlimited batches, forever", "Print-ready sheets (soon)", "Logo + presets (soon)"],
    // Pro isn't scoped to any file, so it's always a direct checkout button.
    cta: "Get Pro",
    href: null,
    action: "pricing-buy-pro",
    style: "hi",
  },
];
---
<div class="plan-row">
  {plans.map((p) => (
    <div class:list={["plan", p.style]}>
      <div class="name">{p.name}</div>
      <div class="price">{p.price}{p.note && <span> {p.note}</span>}</div>
      <ul>{p.features.map((f) => <li>{f}</li>)}</ul>
      {p.href ? (
        <a class:list={["btn", p.style === "hi" ? "btn-accent" : ""]} href={p.href}>{p.cta}</a>
      ) : (
        <button class:list={["btn", p.style === "hi" ? "btn-accent" : ""]} type="button" data-action={p.action} data-tier={p.action === "pricing-buy-batch" ? "batch" : "pro"}>{p.cta}</button>
      )}
    </div>
  ))}
</div>
<p class="pricing-clarity">One-time payment, never a subscription. Your license key works on any device — no account needed, just paste it in.</p>

<script>
  import { startCheckout } from "../lib/bulk/license.js";

  // Neither button here has a file in play -- Pro doesn't need one, and a
  // Batch Pass bought from here just stays unscoped at Dodo until it's
  // claimed by whichever file it's first used on in the bulk workspace.
  document.querySelectorAll("[data-action^='pricing-buy-']").forEach((btn) => {
    btn.addEventListener("click", async () => {
      btn.disabled = true;
      try {
        await startCheckout(btn.dataset.tier, null);
      } catch (err) {
        alert(err.message || "Couldn't start checkout.");
        btn.disabled = false;
      }
    });
  });
</script>

<style>
  .plan-row { display: grid; grid-template-columns: repeat(3, 1fr); }
  .plan { padding: 0 1.8rem 0 0; }
  .plan + .plan { padding-left: 1.8rem; border-left: 1px solid var(--line); }
  .plan .name { font-family: var(--mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--ink-faint); }
  .plan.hi .name { color: var(--red); }
  .plan .price { font-size: 2.2rem; font-weight: 700; margin: 0.5rem 0 1.2rem; letter-spacing: -0.02em; }
  .plan .price span { font-size: 0.8rem; color: var(--ink-faint); font-weight: 400; }
  .plan ul { list-style: none; padding: 0; margin: 0 0 1.5rem; font-size: 0.85rem; color: var(--ink-dim); }
  .plan li { padding: 0.4rem 0; border-top: 1px solid var(--line); }
  .plan li:first-child { border-top: none; }
  .plan .btn { width: 100%; text-align: center; }

  .pricing-clarity { font-size: 0.8rem; color: var(--ink-faint); margin: 1.6rem 0 0; }

  @media (max-width: 700px) {
    .plan-row { grid-template-columns: 1fr; gap: 1.8rem; }
    .plan + .plan { padding-left: 0; border-left: none; }
  }
</style>
