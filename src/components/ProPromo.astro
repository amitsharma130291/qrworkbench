---
// Reusable paid-tier promotion block. Two variants:
//   "strip"  - a slim one-line banner, meant to sit inside pages that already
//              have their own CTA (the 14 individual generator pages, via
//              GeneratorPageLayout).
//   "panel"  - a fuller 3-column mini pricing card, meant for bulk/label/CSV
//              landing pages where a batch or lifetime purchase is the
//              natural next step.
// All feature claims here must match PricingCards.astro / pricing.astro --
// this is marketing copy sitting next to a real checkout, not a rounding-up
// exercise.
const { variant = "strip", heading = "Free up to 20 codes. Pay once for the rest." } = Astro.props;
---
{variant === "strip" ? (
  <div class="pp-strip">
    <span class="pp-strip-text">
      <strong>Bulk pricing:</strong> 20 codes free, then <strong>$7</strong> for one batch up to 5,000, or <strong>$39 once</strong> for unlimited batches forever — plus a logo on every code and printable label sheets.
    </span>
    <a class="pp-strip-link" href="/pricing">See full pricing →</a>
  </div>
) : (
  <section class="pp-panel">
    <h2>{heading}</h2>
    <div class="pp-cols">
      <div class="pp-col">
        <div class="pp-tier">Free</div>
        <div class="pp-price">$0</div>
        <ul>
          <li>Unlimited single codes</li>
          <li>Bulk batches up to 20 codes</li>
        </ul>
      </div>
      <div class="pp-col">
        <div class="pp-tier">Batch Pass</div>
        <div class="pp-price">$7 <span>once</span></div>
        <ul>
          <li>One batch, up to 5,000 codes</li>
          <li>Custom filenames, ZIP export</li>
        </ul>
      </div>
      <div class="pp-col pp-hi">
        <div class="pp-tier">Pro — lifetime</div>
        <div class="pp-price">$39 <span>once</span></div>
        <ul>
          <li>Unlimited batches, forever</li>
          <li>Logo on every code</li>
          <li>Printable label sheets</li>
        </ul>
      </div>
    </div>
    <p class="pp-note">One-time payment, never a subscription. <a href="/pricing">Compare all plans →</a></p>
  </section>
)}

<style>
  .pp-strip {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    border: 1px solid var(--red); background: var(--surface); padding: 0.9rem 1.2rem; margin: 0 0 2.6rem;
  }
  .pp-strip-text { font-size: 0.85rem; color: var(--ink-dim); line-height: 1.5; }
  .pp-strip-text strong { color: var(--ink); }
  .pp-strip-link { font-family: var(--mono); font-size: 0.78rem; font-weight: 700; color: var(--red); white-space: nowrap; text-decoration: none; }
  .pp-strip-link:hover { text-decoration: underline; }

  .pp-panel { border: 1px solid var(--line); background: var(--surface); padding: 2rem 1.8rem; margin: 0 0 3rem; }
  .pp-panel h2 { font-size: 1.15rem; margin: 0 0 1.6rem; letter-spacing: -0.01em; }
  .pp-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.6rem; }
  .pp-col { padding: 0 1.2rem 0 0; border-right: 1px solid var(--line); }
  .pp-col:last-child { border-right: none; padding-right: 0; }
  .pp-tier { font-family: var(--mono); font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--ink-faint); }
  .pp-hi .pp-tier { color: var(--red); }
  .pp-price { font-size: 1.5rem; font-weight: 700; margin: 0.4rem 0 0.8rem; letter-spacing: -0.02em; }
  .pp-price span { font-size: 0.72rem; color: var(--ink-faint); font-weight: 400; }
  .pp-col ul { list-style: none; margin: 0; padding: 0; font-size: 0.82rem; color: var(--ink-dim); line-height: 1.5; }
  .pp-col li { padding: 0.3rem 0 0.3rem 1.1rem; position: relative; }
  .pp-col li::before { content: "—"; position: absolute; left: 0; color: var(--red); }
  .pp-note { font-size: 0.82rem; color: var(--ink-faint); margin: 1.6rem 0 0; }
  .pp-note a { color: var(--red); text-decoration: underline; text-underline-offset: 2px; }

  @media (max-width: 640px) {
    .pp-cols { grid-template-columns: 1fr; gap: 1.2rem; }
    .pp-col { border-right: none; padding-right: 0; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
    .pp-col:last-child { border-bottom: none; padding-bottom: 0; }
  }
</style>
