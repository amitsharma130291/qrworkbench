---
const { name } = Astro.props;
---
{name === "url" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2" y="8" width="10" height="8" rx="4" transform="rotate(-20 7 12)" />
    <rect x="12" y="8" width="10" height="8" rx="4" transform="rotate(-20 17 12)" />
  </svg>
)}
{name === "wifi" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M4 9.5a12 12 0 0 1 16 0" />
    <path d="M7 13a8 8 0 0 1 10 0" />
    <path d="M10 16.5a4 4 0 0 1 4 0" />
    <circle cx="12" cy="19.2" r="0.9" fill="currentColor" stroke="none" />
  </svg>
)}
{name === "vcard" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="5" width="19" height="14" rx="2" />
    <circle cx="9" cy="11" r="2.1" />
    <path d="M5.6 16c.6-1.7 1.9-2.6 3.4-2.6s2.8.9 3.4 2.6" />
    <path d="M15 10h4M15 13.4h4" />
  </svg>
)}
{name === "email" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="2.5" y="5.5" width="19" height="13" rx="2" />
    <path d="M3.5 6.5 12 13l8.5-6.5" />
  </svg>
)}
{name === "pdf" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <path d="M6 2.5h8l4 4V21a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3.5a1 1 0 0 1 1-1Z" />
    <path d="M14 2.5V7h4" />
    <path d="M7.8 12v5.2M10 12v5.2M10 14.3h1.4a1.15 1.15 0 1 0 0-2.3H10Z" />
  </svg>
)}
{name === "form" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
    <rect x="3" y="3.5" width="18" height="17" rx="2" />
    <path d="M7 8.5h10M7 12h10M7 15.5h6" />
    <circle cx="6.2" cy="8.5" r="0" fill="none" />
  </svg>
)}
{name === "more" && (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
    <circle cx="5" cy="12" r="1.1" fill="currentColor" stroke="none" />
    <circle cx="12" cy="12" r="1.1" fill="currentColor" stroke="none" />
    <circle cx="19" cy="12" r="1.1" fill="currentColor" stroke="none" />
  </svg>
)}

<style>
  svg { width: 22px; height: 22px; color: var(--ink); }
</style>
