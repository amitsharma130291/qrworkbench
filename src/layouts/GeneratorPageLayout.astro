---
import Layout from "./Layout.astro";
import { relatedTools, toolBySlug } from "../data/tools.js";

const { title, description, eyebrow, h1, intro, slug, howTo = [], tips = [], bulkNote, bulkHref = "/bulk-qr-code-generator", faq = [] } = Astro.props;

const related = slug ? relatedTools(slug) : [];
const self = slug ? toolBySlug(slug) : null;
const canonicalPath = new URL(Astro.url.pathname, Astro.site).toString();

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: h1,
  description,
  applicationCategory: "UtilitiesApplication",
  operatingSystem: "Any (runs in the browser)",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
};

const howToSchema = howTo.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "HowTo",
  name: h1,
  step: howTo.map((s) => ({ "@type": "HowToStep", text: s })),
} : null;

const faqSchema = faq.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
} : null;

const breadcrumbSchema = self ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", Astro.site).toString() },
    { "@type": "ListItem", position: 2, name: "Tools", item: new URL("/#tools", Astro.site).toString() },
    { "@type": "ListItem", position: 3, name: self.name, item: canonicalPath },
  ],
} : null;
---
<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
    {howToSchema && <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />}
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {breadcrumbSchema && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />}
  </Fragment>

  <div class="frame gen-page">
    {self && (
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/#tools">Tools</a>
        <span>/</span>
        <span aria-current="page">{self.name}</span>
      </nav>
    )}

    <div class="gen-head">
      <div class="index-no">{eyebrow}</div>
      <h1>{h1}</h1>
      <p class="intro">{intro}</p>
    </div>

    <slot />

    {howTo.length > 0 && (
      <section class="how-section">
        <h2>How it works</h2>
        <ol class="how-list">
          {howTo.map((step) => <li>{step}</li>)}
        </ol>
      </section>
    )}

    {tips.length > 0 && (
      <section class="tips-section">
        <h2>Good to know</h2>
        <ul class="tips-list">
          {tips.map((tip) => <li>{tip}</li>)}
        </ul>
      </section>
    )}

    {bulkNote && (
      <a class="bulk-upsell" href={bulkHref}>
        <span>{bulkNote}</span>
        <span class="arrow">Generate from CSV →</span>
      </a>
    )}

    {faq.length > 0 && (
      <div class="gen-faq">
        <h2>Questions</h2>
        {faq.map((item) => (
          <details class="faq-item">
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    )}

    {related.length > 0 && (
      <section class="related-section">
        <h2>Related generators</h2>
        <div class="related-grid">
          {related.map((t) => <a class="related-link" href={t.href}>{t.name} →</a>)}
        </div>
      </section>
    )}
  </div>
</Layout>

<style>
  .gen-page { padding: 1.6rem 1.75rem 5rem; max-width: 900px; }
  .breadcrumb { display: flex; gap: 0.5rem; align-items: center; font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint); margin-bottom: 1.6rem; flex-wrap: wrap; }
  .breadcrumb a { color: var(--ink-faint); text-decoration: none; }
  .breadcrumb a:hover { color: var(--red); text-decoration: underline; }
  .breadcrumb [aria-current="page"] { color: var(--ink-dim); }

  .gen-head { max-width: 68ch; margin-bottom: 0; }
  .index-no { font-family: var(--mono); font-size: 0.72rem; color: var(--red); margin-bottom: 1rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .gen-page h1 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin: 0 0 1rem; letter-spacing: -0.015em; line-height: 1.1; text-wrap: balance; }
  .intro { color: var(--ink-dim); line-height: 1.6; font-size: 1rem; margin: 0; }

  .gen-page h2 { font-size: 1.1rem; margin: 0 0 1.1rem; letter-spacing: -0.01em; }
  .how-section, .tips-section { max-width: 68ch; margin: 0 0 2.6rem; }

  .how-list { list-style: none; counter-reset: how; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.9rem; }
  .how-list li { counter-increment: how; padding-left: 2.2rem; position: relative; font-size: 0.9rem; color: var(--ink-dim); line-height: 1.55; }
  .how-list li::before {
    content: counter(how);
    position: absolute; left: 0; top: 0;
    width: 1.5rem; height: 1.5rem; border: 1px solid var(--red); color: var(--red);
    font-family: var(--mono); font-size: 0.72rem; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }

  .tips-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.7rem; }
  .tips-list li { padding-left: 1.2rem; position: relative; font-size: 0.88rem; color: var(--ink-dim); line-height: 1.55; }
  .tips-list li::before { content: "—"; position: absolute; left: 0; color: var(--red); }

  .bulk-upsell {
    display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
    border: 1px solid var(--ink); background: var(--surface); padding: 1rem 1.3rem; margin: 0 0 3rem;
    text-decoration: none; color: var(--ink);
    transition: background var(--dur-fast) var(--ease-standard);
  }
  .bulk-upsell:hover { background: var(--bg); }
  .bulk-upsell span:first-child { font-size: 0.85rem; }
  .bulk-upsell .arrow { font-family: var(--mono); font-size: 0.78rem; font-weight: 700; color: var(--red); white-space: nowrap; }

  .gen-faq { margin-bottom: 2.8rem; }
  .gen-faq h2 { font-size: 1.1rem; margin: 0 0 1.1rem; letter-spacing: -0.01em; }
  .faq-item { border-top: 1px solid var(--line); padding: 0.9rem 0; }
  .faq-item summary { cursor: pointer; font-size: 0.9rem; font-weight: 600; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+"; display: inline-block; width: 1em; color: var(--red); font-weight: 700; }
  .faq-item[open] summary::before { content: "–"; }
  .faq-item p { margin: 0.7rem 0 0 1em; font-size: 0.85rem; color: var(--ink-dim); line-height: 1.6; }

  .related-section { max-width: 68ch; }
  .related-grid { display: flex; flex-wrap: wrap; gap: 0.7rem; }
  .related-link {
    font-size: 0.85rem; font-weight: 600; color: var(--ink-dim); text-decoration: none;
    border: 1px solid var(--line); padding: 0.6rem 0.9rem;
  }
  .related-link:hover { border-color: var(--red); color: var(--red); }
</style>
