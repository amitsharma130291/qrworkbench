---
import Layout from "./Layout.astro";

const { title, description, eyebrow, h1, intro, updated } = Astro.props;
---
<Layout title={title} description={description}>
  <slot name="head" slot="head" />

  <div class="frame simple-page">
    <div class="page-head">
      <div class="index-no">{eyebrow}</div>
      <h1>{h1}</h1>
      {intro && <p class="intro">{intro}</p>}
      {updated && <p class="updated-note">Last updated: {updated}</p>}
    </div>
    <div class="prose">
      <slot />
    </div>
  </div>
</Layout>

<style>
  .simple-page { padding: 3rem 1.75rem 5rem; max-width: 820px; }
  .page-head { max-width: 70ch; margin-bottom: 2.5rem; }
  .index-no { font-family: var(--mono); font-size: 0.72rem; color: var(--red); margin-bottom: 1rem; letter-spacing: 0.04em; text-transform: uppercase; }
  .simple-page h1 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin: 0 0 1rem; letter-spacing: -0.015em; line-height: 1.1; text-wrap: balance; }
  .intro { color: var(--ink-dim); line-height: 1.6; font-size: 1rem; margin: 0 0 0.8rem; }
  .updated-note { font-family: var(--mono); font-size: 0.72rem; color: var(--ink-faint); margin: 0; }

  .prose :global(h2) { font-size: 1.05rem; font-weight: 700; margin: 2.2rem 0 0.8rem; letter-spacing: -0.005em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(p) { font-size: 0.9rem; line-height: 1.7; color: var(--ink-dim); margin: 0 0 0.9rem; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 0.9rem; padding-left: 1.3rem; font-size: 0.9rem; line-height: 1.7; color: var(--ink-dim); }
  .prose :global(li) { margin-bottom: 0.3rem; }
  .prose :global(li strong) { color: var(--ink); }
  .prose :global(a) { color: var(--red); text-decoration: underline; text-underline-offset: 2px; }
  .prose :global(code) { font-family: var(--mono); font-size: 0.85em; background: var(--surface); border: 1px solid var(--line); padding: 0.05em 0.35em; }
  .prose :global(strong) { color: var(--ink); }
</style>
