---
import Layout from './Layout.astro';
import ProPromo from '../components/ProPromo.astro';
const { title, description, name, intro, action, actionLabel, related = [], faq = [] } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const breadcrumbs = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name, item: url }
  ]
};
const faqSchema = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({
  '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a }
})) };
---
<Layout title={title} description={description}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbs)} />
    {faq.length > 0 && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  </Fragment>
  <div class="frame workflow">
    <nav aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">{name}</span></nav>
    <h1>{name}</h1>
    <p class="intro">{intro}</p>
    {action && <p><a class="btn btn-accent" href={action}>{actionLabel}</a></p>}
    <slot />
    <ProPromo variant="panel" heading="Need a production run? Choose a one-time plan." />
    <section><h2>Questions about {name.toLowerCase()}</h2>
      {faq.map(f => <details><summary>{f.q}</summary><p>{f.a}</p></details>)}
    </section>
    <section><h2>Continue your workflow</h2><div class="related">
      {related.map(r => <a href={r.href}>{r.name} →</a>)}
    </div></section>
  </div>
</Layout>
<style>
  .workflow { max-width: 940px; padding: 2rem 1.75rem 4rem; }
  nav { font-size: .8rem; color: var(--ink-dim); margin-bottom: 1.5rem; }
  h1 { font-size: clamp(1.8rem, 4vw, 2.7rem); line-height: 1.15; }
  .intro { max-width: 70ch; font-size: 1.05rem; line-height: 1.65; color: var(--ink-dim); }
  .workflow :global(section) { margin: 2.6rem 0; }
  .workflow :global(h2) { font-size: 1.25rem; margin-bottom: 1rem; }
  .workflow :global(p), .workflow :global(li) { line-height: 1.65; }
  .workflow :global(a:not(.btn)) { color: var(--red); text-underline-offset: 3px; }
  .workflow :global(pre) { overflow-x: auto; background: var(--surface); border: 1px solid var(--line); padding: 1rem; font-size: .85rem; }
  details { padding: 1rem 0; border-top: 1px solid var(--line); }
  summary { cursor: pointer; font-weight: 600; }
  .related { display: flex; flex-wrap: wrap; gap: 1rem; }
  .related a { padding: .7rem; border: 1px solid var(--line); }
  @media(max-width: 420px) { .workflow { padding: 1.3rem 1rem 3rem; } }
</style>
