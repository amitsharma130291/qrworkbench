---
import Layout from "../../layouts/Layout.astro";
---
<Layout title="Purchase Complete — QR Workbench" description="Activating your QR Workbench license." noindex>
  <div class="frame result">
    <div id="state-pending" class="state">
      <div class="spinner" aria-hidden="true"></div>
      <h1>Activating your license…</h1>
      <p>This only takes a second.</p>
    </div>

    <div id="state-success" class="state" hidden>
      <div class="index-no">PURCHASE COMPLETE</div>
      <h1>You're unlocked</h1>
      <p id="success-tier"></p>
      <p class="key-note">Keep your license key somewhere safe — you'll need it to unlock the bulk workspace on another browser or device.</p>
      <div class="actions">
        <a class="btn btn-accent" href="/bulk">Open the bulk workspace →</a>
      </div>
    </div>

    <div id="state-error" class="state" hidden>
      <div class="index-no">SOMETHING WENT WRONG</div>
      <h1>Couldn't activate that license</h1>
      <p id="error-message"></p>
      <div class="actions">
        <a class="btn btn-fill" href="/contact">Contact support →</a>
        <a class="btn" href="/bulk">Try entering it manually →</a>
      </div>
    </div>

    <div id="state-manual" class="state" hidden>
      <div class="index-no">NO LICENSE KEY FOUND</div>
      <h1>Check your email for your license key</h1>
      <p>Dodo Payments emails a receipt with your license key. Paste it below to unlock the bulk workspace here.</p>
      <form id="manual-form" class="manual-form">
        <input id="manual-key" type="text" placeholder="License key" autocomplete="off" required />
        <button class="btn btn-accent" type="submit">Activate</button>
      </form>
      <p id="manual-error" class="manual-error" hidden></p>
    </div>
  </div>
</Layout>

<script>
  import { getStoredLicense, activateLicense, tierLabel } from "../../lib/license.js";

  const el = (id) => document.getElementById(id);
  const states = ["pending", "success", "error", "manual"];
  function show(state) {
    states.forEach((s) => (el(`state-${s}`).hidden = s !== state));
  }

  function showSuccess(record) {
    el("success-tier").textContent = `${tierLabel(record.tier)} is now active in this browser.`;
    show("success");
  }

  async function run() {
    const params = new URLSearchParams(location.search);
    const licenseKey = params.get("license_key");

    if (!licenseKey) {
      show("manual");
      return;
    }

    // Idempotent on refresh: if this exact key is already activated in this
    // browser, don't call activate() again -- it would consume another
    // activation slot for no reason.
    const cached = getStoredLicense();
    if (cached?.licenseKey === licenseKey) {
      showSuccess(cached);
      return;
    }

    try {
      const record = await activateLicense(licenseKey);
      showSuccess(record);
    } catch (err) {
      el("error-message").textContent = err.message;
      show("error");
    }
  }

  el("manual-form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const key = el("manual-key").value.trim();
    if (!key) return;
    el("manual-error").hidden = true;
    try {
      const record = await activateLicense(key);
      showSuccess(record);
    } catch (err) {
      el("manual-error").textContent = err.message;
      el("manual-error").hidden = false;
    }
  });

  run();
</script>

<style>
  .result { padding: 5rem 1.75rem 6rem; max-width: 560px; text-align: center; }
  .state { display: flex; flex-direction: column; align-items: center; }
  .index-no { font-family: var(--mono); font-size: 0.72rem; color: var(--red); margin-bottom: 1.1rem; letter-spacing: 0.04em; }
  h1 { font-size: 1.8rem; margin: 0 0 1rem; letter-spacing: -0.01em; line-height: 1.15; }
  .state p { color: var(--ink-dim); line-height: 1.6; margin: 0 0 1.2rem; max-width: 42ch; }
  .key-note { font-size: 0.85rem; color: var(--ink-faint); }
  .actions { display: flex; gap: 0.9rem; flex-wrap: wrap; justify-content: center; margin-top: 0.8rem; }

  .spinner {
    width: 32px; height: 32px; border: 3px solid var(--line); border-top-color: var(--red);
    border-radius: 50%; margin-bottom: 1.4rem; animation: spin 0.8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }

  .manual-form { display: flex; gap: 0.7rem; width: 100%; max-width: 380px; margin-top: 0.4rem; }
  .manual-form input {
    flex: 1; font: inherit; font-size: 0.88rem; padding: 0.7rem 0.8rem; border: 1px solid var(--line); background: var(--surface); color: var(--ink);
  }
  .manual-error { color: var(--red); font-size: 0.82rem; margin-top: 0.9rem; }
</style>
