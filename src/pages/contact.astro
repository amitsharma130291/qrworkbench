---
import SimplePageLayout from "../layouts/SimplePageLayout.astro";

const faq = [
  { q: "How long until I get a reply?", a: "There's no support team on staff — messages are read and answered directly, usually within a few business days. This contact form is the one channel; there's no faster escalation path." },
  { q: "Is this the right place to recover a lost license key?", a: "Not usually — try \"Forgot your key?\" on the pricing page first. It resends your key by email instantly, using the address you paid with, with no waiting on a reply here. Only use this form if that tool genuinely doesn't work for your situation." },
  { q: "Is this for bug reports, or just general questions?", a: "Both. For a bug report, include the generator or format you were using and roughly what you typed — that's usually enough to reproduce the issue. For a format request or general question, describe the use case, not just a format name." },
  { q: "Is there a phone number I can call?", a: "No — there's no phone line or live chat. This form is the only way to reach us." },
  { q: "Can I reach you for a partnership, press, or licensing question?", a: "Yes — use the subject line to say so, and include enough detail (who you are, what you're asking) that a first reply can actually be useful." },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---
<SimplePageLayout
  title="Contact | QR Workbench"
  description="Get in touch with QR Workbench -- support questions, bug reports, partnership or press inquiries. No phone line; one contact form, answered directly."
  eyebrow="Contact"
  h1="Get in touch"
  intro="Use this form for support questions, bug reports, partnership or press inquiries, and anything else not already covered elsewhere on the site. Trying to recover a lost license key? Check “Forgot your key?” on the pricing page first — it resends your key by email instantly, without waiting on a reply here."
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <form class="contact-form" id="contact-form" novalidate>
    <div class="field-row">
      <label for="cf-name">Name
        <input id="cf-name" name="name" type="text" autocomplete="name" required maxlength="100" data-role="cf-name" />
      </label>
      <label for="cf-email">Email
        <input id="cf-email" name="email" type="email" autocomplete="email" required maxlength="254" data-role="cf-email" />
      </label>
    </div>
    <label for="cf-subject">Subject
      <input id="cf-subject" name="subject" type="text" required maxlength="150" data-role="cf-subject" />
    </label>
    <label for="cf-message">Message
      <textarea id="cf-message" name="message" rows="6" required maxlength="5000" data-role="cf-message"></textarea>
    </label>

    <div class="honeypot" aria-hidden="true">
      <label for="cf-website">Website</label>
      <input id="cf-website" name="website" type="text" tabindex="-1" autocomplete="off" data-role="cf-website" />
    </div>

    <p class="form-error" data-role="cf-error" role="alert"></p>
    <p class="form-success" data-role="cf-success" role="status" aria-live="polite" hidden></p>

    <button class="btn btn-accent" type="submit" data-role="cf-submit">
      <span data-role="cf-submit-label">Send message</span>
    </button>
  </form>

  <h2>What to include</h2>
  <p>For bug reports, the generator or format you were using and roughly what you typed helps the most — that's usually enough to reproduce the issue directly. For a format request or feature idea, tell us the use case, not just the format name, so a reply can address what you're actually trying to do. For anything else — partnership, press, licensing — a subject line that says so up front gets you a more useful first reply.</p>

  <h2>Response time</h2>
  <p>QR Workbench doesn't have a support team on staff — messages are read and answered directly by the person who built the site. Most messages get a reply within a few business days. This form is the one channel; there's no phone line or live chat.</p>

  <div class="contact-faq">
    <h2>Questions</h2>
    {faq.map((item) => (
      <details class="faq-item">
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))}
  </div>
</SimplePageLayout>

<style>
  .contact-form { max-width: 560px; margin: 0 0 3rem; display: flex; flex-direction: column; gap: 1.1rem; }
  .contact-form label { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.8rem; font-weight: 600; color: var(--ink-dim); }
  .contact-form input, .contact-form textarea {
    font: inherit; font-size: 0.9rem; padding: 0.7rem 0.75rem; border: 1px solid var(--line); background: var(--surface); color: var(--ink);
  }
  .contact-form input:focus-visible, .contact-form textarea:focus-visible { outline: 2px solid var(--red); outline-offset: 1px; }
  .contact-form textarea { resize: vertical; min-height: 130px; }
  .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .honeypot { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .form-error { min-height: 1.2em; margin: 0; font-size: 0.82rem; color: var(--red); font-weight: 600; }
  .form-success {
    margin: 0; font-size: 0.85rem; font-weight: 600; color: var(--success);
    background: #E8F5EE; border: 1px solid var(--success); padding: 0.7rem 0.9rem;
  }

  @media (max-width: 560px) {
    .field-row { grid-template-columns: 1fr; }
  }

  .contact-faq { margin: 2.6rem 0 1rem; }
  .faq-item { border-top: 1px solid var(--line); padding: 0.9rem 0; }
  .faq-item summary { cursor: pointer; font-size: 0.9rem; font-weight: 600; list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary::before { content: "+"; display: inline-block; width: 1em; color: var(--red); font-weight: 700; }
  .faq-item[open] summary::before { content: "–"; }
  .faq-item p { margin: 0.7rem 0 0 1em; font-size: 0.85rem; color: var(--ink-dim); line-height: 1.6; }
</style>

<script>
  const form = document.getElementById("contact-form");
  const els = {
    name: form.querySelector('[data-role="cf-name"]'),
    email: form.querySelector('[data-role="cf-email"]'),
    subject: form.querySelector('[data-role="cf-subject"]'),
    message: form.querySelector('[data-role="cf-message"]'),
    website: form.querySelector('[data-role="cf-website"]'),
    error: form.querySelector('[data-role="cf-error"]'),
    success: form.querySelector('[data-role="cf-success"]'),
    submitBtn: form.querySelector('[data-role="cf-submit"]'),
    submitLabel: form.querySelector('[data-role="cf-submit-label"]'),
  };

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    els.error.textContent = "";
    els.success.hidden = true;
    els.success.textContent = "";

    const payload = {
      name: els.name.value.trim(),
      email: els.email.value.trim(),
      subject: els.subject.value.trim(),
      message: els.message.value.trim(),
      website: els.website.value,
    };

    if (!payload.name || !payload.email || !payload.subject || !payload.message) {
      els.error.textContent = "Fill in every field before sending.";
      return;
    }

    els.submitBtn.disabled = true;
    els.submitLabel.textContent = "Sending…";

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await res.json().catch(() => ({}));

      if (!res.ok) {
        throw new Error(data.error || "Couldn't send your message. Please try again.");
      }

      form.reset();
      els.submitLabel.textContent = "Send message";
      els.submitBtn.disabled = false;
      els.success.textContent = "Message sent — we'll get back to you soon.";
      els.success.hidden = false;
    } catch (err) {
      els.error.textContent = err.message;
      els.submitLabel.textContent = "Send message";
      els.submitBtn.disabled = false;
    }
  });
</script>
