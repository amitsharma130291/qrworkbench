---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Documentation — QRGRID" description="How QRGRID's static QR generation and bulk workflow work.">
  <div class="frame stub">
    <div class="index-no">F — DOCS</div>
    <h1>Documentation</h1>
    <p>Format-by-format guides and CSV column reference are coming soon. For now, the bulk workspace guesses your column mapping automatically — upload a CSV and check the Map Columns panel.</p>
    <a class="btn btn-fill" href="/bulk">Open the bulk workspace →</a>
  </div>
</Layout>

<style>
  .stub { padding: 5rem 1.75rem; max-width: 640px; }
  .index-no { font-family: var(--mono); font-size: 0.72rem; color: var(--red); margin-bottom: 1.2rem; letter-spacing: 0.04em; }
  h1 { font-size: 2rem; margin: 0 0 1rem; letter-spacing: -0.01em; }
  p { color: var(--ink-dim); line-height: 1.6; margin: 0 0 1.8rem; }
</style>
