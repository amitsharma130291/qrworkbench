---
import Layout from "../layouts/Layout.astro";
import ToolIcon from "../components/ToolIcon.astro";
import PricingCards from "../components/PricingCards.astro";

const tools = [
  { icon: "url", name: "URL", desc: "Any link, encoded directly.", href: "/url-qr-code-generator" },
  { icon: "wifi", name: "WiFi", desc: "SSID, password, security type.", href: "/wifi-qr-code-generator" },
  { icon: "vcard", name: "vCard", desc: "Name, phone, company, email.", href: "/vcard-qr-code-generator" },
  { icon: "email", name: "Email", desc: "Compose email, ready to send.", href: "/email-qr-code-generator" },
  { icon: "sms", name: "SMS", desc: "Number and message, pre-filled.", href: "/sms-qr-code-generator" },
  { icon: "phone", name: "Phone", desc: "One tap to dial.", href: "/phone-qr-code-generator" },
  { icon: "pdf", name: "PDF", desc: "Encode a link to a hosted PDF.", href: "/pdf-qr-code-generator" },
  { icon: "form", name: "Google Forms", desc: "Forms, surveys and more.", href: "/google-forms-qr-code-generator" },
  { icon: "social", name: "Facebook", desc: "Link to your page or post.", href: "/facebook-qr-code-generator" },
  { icon: "social", name: "Instagram", desc: "Link to your profile.", href: "/instagram-qr-code-generator" },
  { icon: "social", name: "LinkedIn", desc: "Link to your profile.", href: "/linkedin-qr-code-generator" },
  { icon: "social", name: "WhatsApp", desc: "Pre-filled chat, ready to send.", href: "/whatsapp-qr-code-generator" },
  { icon: "social", name: "YouTube", desc: "Link to a video or channel.", href: "/youtube-qr-code-generator" },
  { icon: "social", name: "Spotify", desc: "Link to a track or playlist.", href: "/spotify-qr-code-generator" },
];

const useCases = [
  { n: "01", title: "Product & inventory labels", body: "Encode product URLs, use SKUs as filenames, and add product names as captions.", io: "product URL  →  SKU001-blue-shirt.svg" },
  { n: "02", title: "Employee & event vCards", body: "Turn a staff or attendee spreadsheet into individually named contact QR codes.", io: "Jordan Rivera row  →  jordan-rivera.svg (vCard)" },
  { n: "03", title: "Asset tracking", body: "Generate sequentially named codes for equipment, rooms, containers, or inventory.", io: "Room 204 row  →  room-204.svg" },
  { n: "04", title: "Print-shop production", body: "Export high-resolution SVGs, transparent PNGs, and print-ready label sheets from one CSV.", io: "client.csv  →  codes.zip + labels.pdf" },
  { n: "05", title: "Events & hospitality", body: "Produce codes for tickets, menus, or tables — named and captioned automatically.", io: "Table 12 row  →  table-12.svg" },
];

const taskRows = [
  ["Copy each URL by hand", "Upload all rows at once"],
  ["Generate codes individually", "Generate one complete batch"],
  ["Rename files manually", "Map filenames from a column"],
  ["Build label sheets yourself", "Export print-ready PDFs"],
  ["Upload sensitive data to a server", "Process everything locally"],
];

const tierRows = [
  { label: "Generate one QR code", free: true, batch: true, pro: true },
  { label: "Import a spreadsheet, any size", free: true, batch: true, pro: true },
  { label: "Map filename, caption & content columns", free: true, batch: true, pro: true },
  { label: "WiFi & vCard-formatted bulk codes", free: true, batch: true, pro: true },
  { label: "SVG + PNG production files", free: true, batch: true, pro: true },
  { label: "Export past the free 20-row cap", free: false, batch: true, pro: true },
  { label: "Unlimited batches, forever", free: false, batch: false, pro: true },
  { label: "Logo overlay on every code in a batch", free: false, batch: false, pro: true },
  { label: "Printable label sheets (PDF)", free: false, batch: false, pro: true },
];

const faq = [
  { q: "Are the QR codes permanent? Will they stop working?", a: "Yes, permanent — every code here is static, meaning the destination is encoded directly into the pattern. It keeps working for as long as the destination exists, with no dependency on QR Workbench staying online." },
  { q: "Is my spreadsheet uploaded anywhere?", a: "No. CSV parsing, QR generation, ZIP packing, and PDF layout all happen in your browser tab — the file itself is never sent to a server." },
  { q: "Do people who scan my codes pass through a QR Workbench redirect?", a: "No. There's no redirect server in the loop — a scan goes straight to the destination you encoded." },
  { q: "Do I need an account?", a: "No, for anything — the free generators, the bulk workspace, and paid plans all work with no signup, ever." },
  { q: "What happens if my CSV has errors?", a: "A row missing its required QR-data value is skipped automatically, and a filename that would collide with another gets a number appended — neither produces a broken or overwritten file." },
  { q: "Which spreadsheet columns can I map?", a: "QR content (or, for WiFi/vCard batches, the relevant fields like SSID or name/phone/email), filename, caption, price, and category." },
  { q: "Can I add a logo?", a: "Yes — free on every individual generator, and on Pro for bulk batches, where it's applied to every code at once." },
  { q: "Can I create A4 or Letter label sheets?", a: "Yes, on Pro — set page size, columns, rows, margin and spacing, and export a print-ready PDF." },
  { q: "Is there a sample CSV to try first?", a: "Yes — the bulk workspace has a one-click sample download, and there's a live sample batch right on this page you can try with no upload at all." },
];

const sampleRows = [
  { sku: "SKU001", product: "Blue Cotton T-Shirt", url: "https://example.com/products/blue-cotton-t-shirt" },
  { sku: "SKU002", product: "Red Hoodie", url: "https://example.com/products/red-hoodie" },
  { sku: "SKU003", product: "Green Cap", url: "https://example.com/products/green-cap" },
  { sku: "SKU004", product: "Black Tote Bag", url: "https://example.com/products/black-tote-bag" },
  { sku: "SKU005", product: "White Mug", url: "https://example.com/products/white-mug" },
  { sku: "SKU006", product: "Navy Notebook", url: "https://example.com/products/navy-notebook" },
];
---
<Layout
  title="QR Workbench — Free QR Code Generator for 14 Formats"
  description="Free QR codes for URLs, WiFi, vCards, email and more — generated entirely in your browser. Bulk CSV-to-ZIP generation for hundreds at once, one-time payment."
>
  <div class="hero">
    <div class="frame hero-grid">
      <div class="hero-text">
        <div class="index-no">A1 — CSV TO QR PRODUCTION</div>
        <h1>Turn a spreadsheet into <span class="rd">thousands</span> of production-ready QR codes.</h1>
        <p class="lede">
          Upload a CSV, map your columns, and download correctly named PNGs, SVGs or printable
          label sheets — without uploading your data.
        </p>
        <div class="cta-row">
          <a class="btn btn-accent" href="/bulk">Try a batch free</a>
          <a class="btn" href="#free-generator">Create one QR now</a>
        </div>
        <p class="cta-micro">Up to 20 rows · No account · Nothing uploaded</p>
      </div>

      <div class="hero-visual">
        <div class="flow-card" aria-hidden="true">
          <div class="fc-file">products.csv <span>— 2,500 rows</span></div>
          <div class="fc-arrow">↓</div>
          <div class="fc-map">
            <span><b>URL</b> → QR content</span>
            <span><b>SKU</b> → filename</span>
            <span><b>Product</b> → caption</span>
          </div>
          <div class="fc-arrow">↓</div>
          <div class="fc-out">
            <span>2,500 named SVGs</span>
            <span>qr-codes.zip</span>
            <span>printable-labels.pdf</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="frame">
    <ul class="cred-strip">
      <li><strong>5,000 codes</strong><span>per batch</span></li>
      <li><strong>100%</strong><span>browser processing</span></li>
      <li><strong>PNG · SVG · PDF</strong><span>output formats</span></li>
      <li><strong>No account</strong><span>ever required</span></li>
    </ul>
  </div>

  <div class="frame">
    <section id="free-generator" class="grid-row">
      <div class="row-label">
        <div class="idx">B — 01</div>
        <h2>Create one QR code free</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">No account, nothing uploaded — paste a link and download a real QR code in seconds.</p>
        <div class="mini-gen">
          <div class="mini-gen-input">
            <label for="mini-url">Website URL</label>
            <input id="mini-url" type="url" placeholder="https://example.com/product" autocomplete="off" />
            <button class="mini-custom-toggle" id="mini-custom-toggle" type="button" aria-expanded="false">Customize size, error correction &amp; margin ▾</button>
            <div class="mini-custom-panel" id="mini-custom-panel" hidden>
              <label>Size<select id="mini-size">
                <option value="500">500 px</option>
                <option value="800" selected>800 px</option>
                <option value="1000">1000 px</option>
              </select></label>
              <label>Error correction<select id="mini-ec">
                <option value="L">L — ~7%</option>
                <option value="M" selected>M — ~15%</option>
                <option value="Q">Q — ~25%</option>
                <option value="H">H — ~30%</option>
              </select></label>
              <label class="mini-check"><input id="mini-margin" type="checkbox" checked /> Include quiet zone</label>
            </div>
            <p class="mini-gen-badge">Free · No account · Processed in your browser</p>
          </div>
          <div class="mini-gen-preview">
            <div class="mini-qr-panel">
              <canvas id="mini-qr-canvas" width="200" height="200" hidden></canvas>
              <p class="mini-qr-empty" id="mini-qr-empty">Your QR code will appear here.</p>
            </div>
            <button class="btn btn-fill" id="mini-download" type="button" disabled>Download PNG</button>
          </div>
        </div>
        <a class="mini-more-link" href="#tools">More free QR types — WiFi, vCard, email &amp; more →</a>

        <div class="mini-success" id="mini-success" hidden>
          <strong class="mini-success-head">Your QR code is ready.</strong>
          <p class="mini-success-dest" id="mini-success-dest"></p>
          <div class="mini-success-actions">
            <button class="btn btn-fill" id="mini-download-svg" type="button">Download SVG</button>
            <button class="btn" id="mini-edit" type="button">Edit QR</button>
          </div>
          <p class="mini-scan-tip">Scan it with your own phone before printing or sharing, to confirm it works.</p>

          <div class="mini-upsell" id="mini-upsell">
            <strong id="mini-upsell-head">Have a product catalogue or URL list?</strong>
            <p id="mini-upsell-body">Generate a named QR code for every row — the same size, error correction and margin settings, applied to the whole spreadsheet.</p>
            <a class="btn btn-accent" href="/bulk" id="mini-upsell-cta">Apply this design to a batch →</a>
          </div>
        </div>
      </div>
    </section>

    <section id="bulk" class="grid-row">
      <div class="row-label">
        <div class="idx">C — 02</div>
        <h2>Need hundreds or thousands? Bulk workspace.</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">Upload a spreadsheet and export a complete, correctly named production set.</p>
        <div class="flow">
          <div class="flow-step"><span class="n">01</span><h4>Upload the sheet</h4><p>A CSV of names, SKUs or links — any number of rows.</p></div>
          <div class="flow-step"><span class="n">02</span><h4>Map the columns</h4><p>Filename, caption, content, format, size, color.</p></div>
          <div class="flow-step"><span class="n">03</span><h4>Export the set</h4><p>Named SVGs or PNGs, packed into a ZIP — or a printable PDF sheet.</p></div>
        </div>
        <p class="section-note">Free to try — up to 20 codes per batch, a real export, not a locked preview. A one-time payment unlocks the rest, see pricing below.</p>
        <a class="btn btn-fill bulk-link" href="/bulk">Try a batch free →</a>
      </div>
    </section>

    <section class="grid-row" id="demo">
      <div class="row-label">
        <div class="idx">D — 03</div>
        <h2>See it work, before you upload anything</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">Real sample rows, generated live below — change the mapping and watch the output update.</p>
        <div class="demo-panel">
          <div class="demo-table-wrap">
            <table class="demo-table">
              <thead><tr><th>SKU</th><th>Product</th><th>URL</th></tr></thead>
              <tbody>
                {sampleRows.map((r) => <tr><td>{r.sku}</td><td>{r.product}</td><td>{r.url.replace("https://example.com", "…")}</td></tr>)}
              </tbody>
            </table>
          </div>
          <div class="demo-map">
            <label>QR content<select id="demo-content"><option value="url" selected>URL</option><option value="sku">SKU</option><option value="product">Product</option></select></label>
            <label>Filename<select id="demo-filename"><option value="sku" selected>SKU</option><option value="product">Product</option><option value="url">URL</option></select></label>
            <label>Caption<select id="demo-caption"><option value="product" selected>Product</option><option value="sku">SKU</option><option value="url">URL</option></select></label>
          </div>
          <div class="demo-output" id="demo-output"></div>
          <p class="demo-hint">Click any code to open it full size.</p>
          <div class="demo-actions">
            <button class="btn btn-fill" id="demo-download" type="button">Download sample ZIP</button>
            <button class="btn" id="demo-download-svg" type="button">Download 1 sample SVG</button>
            <button class="btn" id="demo-download-pdf" type="button">Download sample label PDF</button>
            <a class="btn btn-accent" href="/bulk">Upload your CSV →</a>
          </div>
          <p class="demo-safeguards">In the real bulk workspace, a row missing its QR value is skipped automatically, and a filename that would collide with another gets a number appended — neither produces a broken or overwritten file.</p>
        </div>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">E — 04</div>
        <h2>Replace hours of repetitive production with one workflow.</h2>
      </div>
      <div class="row-content">
        <div class="table-wrap">
          <table class="cmp-table">
            <thead><tr><th>Manual workflow</th><th>QR Workbench</th></tr></thead>
            <tbody>
              {taskRows.map(([before, after]) => <tr><td>{before}</td><td>{after}</td></tr>)}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">F — 05</div>
        <h2>Real jobs this replaces</h2>
      </div>
      <div class="row-content">
        <div class="usecase-grid">
          {useCases.map((u) => (
            <div class="usecase-card">
              <span class="uc-n">{u.n}</span>
              <h3>{u.title}</h3>
              <p>{u.body}</p>
              <code class="uc-io">{u.io}</code>
            </div>
          ))}
        </div>
        <a class="btn btn-fill" href="/bulk">Try a batch free →</a>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">G — 06</div>
        <h2>From spreadsheet to print-ready labels</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">A dedicated PDF layout tool, not just a bigger QR export — one of the reasons this is a production toolkit, not just a generator.</p>
        <div class="label-demo">
          <div class="label-sheet" aria-hidden="true">
            {Array.from({ length: 12 }).map(() => (
              <div class="label-cell"><span class="label-qr"></span><span class="label-cap"></span></div>
            ))}
          </div>
          <div class="label-closeup" aria-hidden="true">
            <span class="label-qr label-qr-big"></span>
            <span class="label-cap-big">SKU001-blue-shirt</span>
          </div>
          <ul class="label-controls">
            <li>A4 or US Letter</li>
            <li>Columns &amp; rows per page</li>
            <li>Margin &amp; spacing</li>
            <li>Caption / SKU text</li>
            <li>Error correction level</li>
            <li>Paginated automatically</li>
          </ul>
        </div>
        <a class="btn btn-fill" href="/labels">Create a sample label sheet →</a>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">H — 07</div>
        <h2>Your spreadsheet never leaves your device</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">QR generation, CSV processing, ZIP creation and PDF layout all happen locally in your browser. Customer details, employee contacts, inventory records and internal URLs are never uploaded to QR Workbench.</p>
        <div class="privacy-flow">
          <div class="pf-node">Your CSV</div>
          <div class="pf-arrow">→</div>
          <div class="pf-node">Processed in your browser</div>
          <div class="pf-arrow">→</div>
          <div class="pf-node">QR files &amp; printable sheets</div>
        </div>
        <ul class="privacy-list">
          <li>No cloud upload</li>
          <li>No account database</li>
          <li>No tracking redirect</li>
          <li>No hosted dependency</li>
          <li>No expiration</li>
          <li>No vendor lock-in</li>
        </ul>
        <p class="section-note privacy-precise">To be precise about what "private" means here: only two things on this site involve an external service at all — the paid checkout (handled entirely by Dodo Payments) and ordinary site analytics. Neither ever sees your CSV, your QR content, or anything you generate.</p>
      </div>
    </section>

    <section id="tools" class="grid-row">
      <div class="row-label">
        <div class="idx">I — 08</div>
        <h2>Need one code? Free, forever.</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">Create unlimited individual static QR codes — no account, no limit.</p>
        <div class="tool-strip">
          {tools.map((t) => (
            <a class="tool-item" href={t.href}>
              <ToolIcon name={t.icon} />
              <div>
                <h3>{t.name}</h3>
                <p>{t.desc}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">J — 09</div>
        <h2>Create the code, download it, own the result</h2>
      </div>
      <div class="row-content">
        <p class="section-note lead-note">Static codes like these encode their destination directly — no ongoing dependency on us or anyone else.</p>
        <div class="table-wrap">
          <table class="cmp-table">
            <thead><tr><th>QR Workbench static codes</th><th>Typical dynamic QR services</th></tr></thead>
            <tbody>
              <tr><td>Destination encoded directly</td><td>Routes through a provider's server</td></tr>
              <tr><td>Continues working independently</td><td>May depend on an active service</td></tr>
              <tr><td>No redirect tracking</td><td>Redirects may be tracked</td></tr>
              <tr><td>One-time production workflow</td><td>Commonly tied to a subscription</td></tr>
              <tr><td>No hosted-code dependency</td><td>Provider remains in the loop</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section id="pricing" class="grid-row">
      <div class="row-label">
        <div class="idx">K — 10</div>
        <h2>Pricing</h2>
      </div>
      <div class="row-content">
        <PricingCards />
        <p class="section-note pricing-note">Test the complete workflow with your first 20 rows before paying for anything. <a href="/pricing">See the full pricing page →</a></p>

        <div class="table-wrap tier-table-wrap">
          <table class="cmp-table tier-table">
            <thead><tr><th>Capability</th><th>Free</th><th>Batch Pass</th><th>Pro</th></tr></thead>
            <tbody>
              {tierRows.map((r) => (
                <tr>
                  <td>{r.label}</td>
                  <td class="tier-mark">{r.free ? "✓" : "—"}</td>
                  <td class="tier-mark">{r.batch ? "✓" : "—"}</td>
                  <td class="tier-mark">{r.pro ? "✓" : "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="grid-row">
      <div class="row-label">
        <div class="idx">L — 11</div>
        <h2>Questions</h2>
      </div>
      <div class="row-content">
        <div class="home-faq">
          {faq.map((item) => (
            <details class="faq-item">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section class="grid-row final-row">
      <div class="row-label">
        <div class="idx">M — 12</div>
      </div>
      <div class="row-content">
        <h2 class="final-h2" id="final-h2">Your spreadsheet is already the hard part.</h2>
        <p class="section-note lead-note" id="final-sub">Turn it into a complete set of named, production-ready QR codes.</p>
        <div class="final-output" aria-hidden="true">
          <span>SKU001-blue-shirt.svg</span>
          <span>SKU002-red-hoodie.svg</span>
          <span>qr-codes.zip</span>
        </div>
        <div class="final-cta">
          <a class="btn btn-accent" href="/bulk" id="final-cta-btn">Try a batch free</a>
          <span class="cta-micro">Up to 20 rows · No account · Nothing uploaded</span>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  import { renderQR, qrToSVGString, qrToPNGBlob } from "../lib/qr.js";
  import JSZip from "jszip";
  import { jsPDF } from "jspdf";

  const SAMPLE_ROWS = [
    { sku: "SKU001", product: "Blue Cotton T-Shirt", url: "https://example.com/products/blue-cotton-t-shirt" },
    { sku: "SKU002", product: "Red Hoodie", url: "https://example.com/products/red-hoodie" },
    { sku: "SKU003", product: "Green Cap", url: "https://example.com/products/green-cap" },
    { sku: "SKU004", product: "Black Tote Bag", url: "https://example.com/products/black-tote-bag" },
    { sku: "SKU005", product: "White Mug", url: "https://example.com/products/white-mug" },
    { sku: "SKU006", product: "Navy Notebook", url: "https://example.com/products/navy-notebook" },
  ];

  function sanitize(v) {
    return String(v || "").trim().replace(/[^a-zA-Z0-9-_]+/g, "-").replace(/^-+|-+$/g, "") || "code";
  }

  const output = document.getElementById("demo-output");
  const contentSel = document.getElementById("demo-content");
  const filenameSel = document.getElementById("demo-filename");
  const captionSel = document.getElementById("demo-caption");
  const downloadBtn = document.getElementById("demo-download");
  const downloadSvgBtn = document.getElementById("demo-download-svg");
  const downloadPdfBtn = document.getElementById("demo-download-pdf");

  async function renderDemo() {
    output.innerHTML = "";
    for (const row of SAMPLE_ROWS) {
      const item = document.createElement("div");
      item.className = "demo-item";
      const canvas = document.createElement("canvas");
      canvas.width = 150;
      canvas.height = 150;
      canvas.tabIndex = 0;
      canvas.setAttribute("role", "button");
      canvas.setAttribute("aria-label", "Open this sample QR code full size");
      item.appendChild(canvas);
      const label = document.createElement("div");
      const filename = `${sanitize(row[filenameSel.value])}.svg`;
      label.innerHTML = `<strong>${filename}</strong><span>${row[captionSel.value]}</span>`;
      item.appendChild(label);
      output.appendChild(item);
      await renderQR(canvas, row[contentSel.value], { width: 150, margin: 1, light: "#ffffff" });

      const openFull = () => {
        const win = window.open();
        if (win) win.document.write(`<title>${filename}</title><body style="margin:0;display:flex;align-items:center;justify-content:center;min-height:100vh;background:#fff"><img src="${canvas.toDataURL("image/png")}" style="width:min(80vw,480px);height:auto" /></body>`);
      };
      canvas.addEventListener("click", openFull);
      canvas.addEventListener("keydown", (e) => {
        if (e.key === "Enter" || e.key === " ") {
          e.preventDefault();
          openFull();
        }
      });
    }
  }

  [contentSel, filenameSel, captionSel].forEach((sel) => sel.addEventListener("change", renderDemo));

  downloadBtn.addEventListener("click", async () => {
    downloadBtn.disabled = true;
    downloadBtn.textContent = "Zipping…";
    try {
      const zip = new JSZip();
      const used = new Set();
      for (const row of SAMPLE_ROWS) {
        let name = `${sanitize(row[filenameSel.value])}.svg`;
        let n = 1;
        while (used.has(name)) {
          name = name.replace(/(\.svg)$/, `-${n}$1`);
          n++;
        }
        used.add(name);
        const svg = await qrToSVGString(row[contentSel.value], { margin: 4, width: 1000 });
        zip.file(name, svg);
      }
      const blob = await zip.generateAsync({ type: "blob" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "qrworkbench-sample.zip";
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    } finally {
      downloadBtn.disabled = false;
      downloadBtn.textContent = "Download sample ZIP";
    }
  });

  function downloadBlob(blob, filename) {
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
  }

  downloadSvgBtn.addEventListener("click", async () => {
    downloadSvgBtn.disabled = true;
    try {
      const row = SAMPLE_ROWS[0];
      const svg = await qrToSVGString(row[contentSel.value], { margin: 4, width: 1000 });
      downloadBlob(new Blob([svg], { type: "image/svg+xml" }), `${sanitize(row[filenameSel.value])}.svg`);
    } finally {
      downloadSvgBtn.disabled = false;
    }
  });

  // A real print-ready PDF, same renderQR()/jsPDF pipeline the actual
  // /labels workspace uses -- demonstrates the real Pro-tier printable
  // sheet feature, not a fabricated example.
  downloadPdfBtn.addEventListener("click", async () => {
    downloadPdfBtn.disabled = true;
    downloadPdfBtn.textContent = "Building PDF…";
    try {
      const pageW = 215.9;
      const pageH = 279.4;
      const margin = 20;
      const cols = 3;
      const rows = 2;
      const gap = 6;
      const cellW = (pageW - margin * 2 - (cols - 1) * gap) / cols;
      const cellH = (pageH - margin * 2 - (rows - 1) * gap) / rows;
      const qrSize = Math.min(cellW, cellH) * 0.7;
      const doc = new jsPDF({ unit: "mm", format: [pageW, pageH] });
      const canvas = document.createElement("canvas");
      for (let i = 0; i < SAMPLE_ROWS.length; i++) {
        const row = SAMPLE_ROWS[i];
        const col = i % cols;
        const r = Math.floor(i / cols);
        const x = margin + col * (cellW + gap);
        const y = margin + r * (cellH + gap);
        const qrX = x + (cellW - qrSize) / 2;
        const qrY = y + (cellH - qrSize - 6) / 2;
        await renderQR(canvas, row[contentSel.value], { width: 300, margin: 1 });
        doc.addImage(canvas.toDataURL("image/png"), "PNG", qrX, qrY, qrSize, qrSize);
        doc.setFontSize(9 * 2.83);
        doc.text(String(row[captionSel.value]), x + cellW / 2, qrY + qrSize + 5, { align: "center", maxWidth: cellW });
      }
      doc.save("qrworkbench-sample-labels.pdf");
    } finally {
      downloadPdfBtn.disabled = false;
      downloadPdfBtn.textContent = "Download sample label PDF";
    }
  });

  renderDemo();

  // Compact free generator: a real, minimal version of the individual URL
  // generator, embedded directly on the homepage so SEO/broad-search
  // visitors can complete a useful free action without leaving the page.
  // The bulk upsell only appears once a code has actually been generated,
  // never before -- it's a bridge from a completed free action, not an
  // interruption.
  (function initMiniGenerator() {
    const input = document.getElementById("mini-url");
    const canvas = document.getElementById("mini-qr-canvas");
    const empty = document.getElementById("mini-qr-empty");
    const downloadBtn = document.getElementById("mini-download");
    const downloadSvgBtn = document.getElementById("mini-download-svg");
    const editBtn = document.getElementById("mini-edit");
    const success = document.getElementById("mini-success");
    const successDest = document.getElementById("mini-success-dest");
    const customToggle = document.getElementById("mini-custom-toggle");
    const customPanel = document.getElementById("mini-custom-panel");
    const sizeSel = document.getElementById("mini-size");
    const ecSel = document.getElementById("mini-ec");
    const marginChk = document.getElementById("mini-margin");
    const upsellCta = document.getElementById("mini-upsell-cta");
    const finalH2 = document.getElementById("final-h2");
    const finalSub = document.getElementById("final-sub");
    const finalCtaBtn = document.getElementById("final-cta-btn");
    if (!input) return;

    let lastValue = "";
    let hasGeneratedOnce = false;

    function markGeneratedOnce() {
      if (hasGeneratedOnce) return;
      hasGeneratedOnce = true;
      if (finalH2) finalH2.textContent = "Your QR design is ready.";
      if (finalSub) finalSub.textContent = "Apply it to your whole spreadsheet.";
      if (finalCtaBtn) finalCtaBtn.textContent = "Apply this design to a batch";
    }

    // Only carries settings that genuinely exist on both sides -- the bulk
    // workspace has no foreground/background color or logo controls today,
    // so promising to "preserve" those would be false. Size, error
    // correction and quiet-zone all map directly to BulkWorkspace's own
    // config panel (cfg-size/cfg-ec/cfg-quietzone).
    function bulkUrlWithSettings() {
      const params = new URLSearchParams({
        size: sizeSel.value,
        ec: ecSel.value,
        margin: marginChk.checked ? "1" : "0",
      });
      return `/bulk?${params.toString()}`;
    }

    customToggle.addEventListener("click", () => {
      const open = customPanel.hidden;
      customPanel.hidden = !open;
      customToggle.setAttribute("aria-expanded", String(open));
      customToggle.textContent = open ? "Customize size, error correction & margin ▴" : "Customize size, error correction & margin ▾";
      if (lastValue) update();
    });

    function currentOpts(width) {
      return {
        width,
        margin: marginChk.checked ? 4 : 0,
        errorCorrectionLevel: ecSel.value,
        light: "#ffffff",
      };
    }

    async function update() {
      const value = input.value.trim();
      lastValue = value;
      if (!value) {
        canvas.hidden = true;
        empty.hidden = false;
        downloadBtn.disabled = true;
        success.hidden = true;
        return;
      }
      canvas.hidden = false;
      empty.hidden = true;
      downloadBtn.disabled = false;
      await renderQR(canvas, value, currentOpts(200));
      successDest.textContent = value;
      upsellCta.href = bulkUrlWithSettings();
      success.hidden = false;
      markGeneratedOnce();
    }

    input.addEventListener("input", update);
    [sizeSel, ecSel].forEach((el) => el.addEventListener("change", () => lastValue && update()));
    marginChk.addEventListener("change", () => lastValue && update());

    downloadBtn.addEventListener("click", async () => {
      if (!lastValue) return;
      const blob = await qrToPNGBlob(lastValue, currentOpts(Number(sizeSel.value)));
      downloadMiniFile(blob, "qr-code.png");
    });

    downloadSvgBtn.addEventListener("click", async () => {
      if (!lastValue) return;
      const svg = await qrToSVGString(lastValue, currentOpts(Number(sizeSel.value)));
      downloadMiniFile(new Blob([svg], { type: "image/svg+xml" }), "qr-code.svg");
    });

    function downloadMiniFile(blob, filename) {
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      URL.revokeObjectURL(url);
    }

    editBtn.addEventListener("click", () => {
      input.focus();
      input.select();
    });
  })();
</script>

