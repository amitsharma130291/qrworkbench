---
import Layout from "../layouts/Layout.astro";
---
<Layout title="Label Generator — QR Workbench" description="Print-ready QR label sheets, coming soon to QR Workbench." noindex>
  <div class="frame stub">
    <div class="index-no">E — SOON</div>
    <h1>Label Generator</h1>
    <p>Rows, columns, captions, bleed — a print-ready PDF sheet of QR labels sized to your stock. This is next up after the bulk workspace.</p>
    <a class="btn btn-fill" href="/bulk">Try the bulk workspace →</a>
  </div>
</Layout>

<style>
  .stub { padding: 5rem 1.75rem; max-width: 640px; }
  .index-no { font-family: var(--mono); font-size: 0.72rem; color: var(--red); margin-bottom: 1.2rem; letter-spacing: 0.04em; }
  h1 { font-size: 2rem; margin: 0 0 1rem; letter-spacing: -0.01em; }
  p { color: var(--ink-dim); line-height: 1.6; margin: 0 0 1.8rem; }
</style>
